перечисление Цвета {
  значение Красный;
  значение Зеленый;
  значение Синий;
}

сущность Вагон {

  // Номер вагона
  реквизит Номер {
    тип Строка;
  };

  // Цвет
  реквизит Цвет {
    тип Цвета;
  };

  // Длина
  реквизит Длина {
    тип Число;
  };

  // Вес
  реквизит Вес {
    тип Число;
  };

}

сущность Поезд {

  // Номер поезда
  реквизит Номер {
    тип Строка;
  };

  реквизит Вагоны {
    тип Вагон[];
  }

}