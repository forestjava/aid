table alis.waybill_tariff_mark {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute waybill_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.waybill.id;
    }
  }

  attribute code {
    type integer;
  }

  attribute name {
    type varchar;
  }

  attribute note {
    type varchar;
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }
}
