/*
Вагон накладной (waybill_railway_carriage)
Связь накладной с вагонами
*/

class WaybillRailwayCarriage {
  label "Вагон накладной";

  // Идентификатор записи
  attribute id {
    type uuid;
    key primary;
  }

  // Собственник вагона
  attribute ownership {
    type varchar(255);
    is nullable;
    sync Etran.waybill_railway_carriage.ownership;
  }

  // Ранее перевозимый груз
  attribute previouslyTransported {
    type varchar(500);
    is nullable;
    sync Etran.waybill_railway_carriage.previously_transported;
  }

  // Провозная плата
  attribute carriageFee {
    type varchar(100);
    is nullable;
    sync Etran.waybill_railway_carriage.carriage_fee;
  }

  // Номер в поезде
  attribute trainNumber {
    type varchar(50);
    is nullable;
    sync Etran.waybill_railway_carriage.train_number;
  }

  // Масса брутто
  attribute weightGross {
    type varchar(50);
    is nullable;
    sync Etran.waybill_railway_carriage.weight_gross;
  }

  // Масса нетто
  attribute weightNet {
    type varchar(50);
    is nullable;
    sync Etran.waybill_railway_carriage.weight_net;
  }

  // Количество мест
  attribute placeCount {
    type varchar(50);
    is nullable;
    sync Etran.waybill_railway_carriage.place_count;
  }

  /*===============================================

            НАВИГАЦИОННЫЕ АТРИБУТЫ И МЕТОДЫ
  
  ===============================================*/

  // Ссылка на накладную
  attribute waybill {
    type Waybill;
  }

  // Ссылка на вагон (справочник)
  attribute railwayCarriage {
    type RailwayCarriage;
  }
}
