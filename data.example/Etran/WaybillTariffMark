/*
Тарифная отметка накладной (waybill_tariff_marks)
Тарифные отметки в накладной
*/

class WaybillTariffMark {
  label "Тарифная отметка накладной";

  // Идентификатор записи
  attribute id {
    type uuid;
    key primary;
  }

  // Код
  attribute code {
    type varchar(100);
    is nullable;
    sync Etran.waybill_tariff_marks.code;
  }

  // Наименование
  attribute name {
    type varchar(500);
    is nullable;
    sync Etran.waybill_tariff_marks.name;
  }

  // Замечание
  attribute note {
    type varchar(1000);
    is nullable;
    sync Etran.waybill_tariff_marks.note;
  }

  /*===============================================

            НАВИГАЦИОННЫЕ АТРИБУТЫ И МЕТОДЫ
  
  ===============================================*/

  // Ссылка на накладную
  attribute waybill {
    type Waybill;
  }
}
