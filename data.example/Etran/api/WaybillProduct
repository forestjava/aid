// DTO.WaybillProduct - Груз накладной (список)
dto DTO.WaybillProduct {
  description "Груз накладной";

  attribute id {
    type uuid;
    map ALIS.WaybillProduct.id;
  }

  attribute etsngCode {
    type DTO.EtsngCode;
    map ALIS.WaybillProduct.etsngCode;
  }

  attribute weight {
    type number;
    is nullable;
    map ALIS.WaybillProduct.weight;
  }

  attribute volume {
    type number;
    is nullable;
    map ALIS.WaybillProduct.volume;
  }

  attribute length {
    type number;
    is nullable;
    map ALIS.WaybillProduct.length;
  }

  attribute width {
    type number;
    is nullable;
    map ALIS.WaybillProduct.width;
  }

  attribute height {
    type number;
    is nullable;
    map ALIS.WaybillProduct.height;
  }

  attribute additional {
    type string;
    is nullable;
    map ALIS.WaybillProduct.additional;
  }
}

