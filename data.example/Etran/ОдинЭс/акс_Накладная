// Сущность из 1С: Документ.акс_Накладная (ЭТРАН)
// Описание накладной ГУ-27 из внешней системы 1С
// Содержит только ключевые реквизиты и реквизиты, участвующие в обмене

сущность Документ.акс_Накладная {
  заголовок "Накладная ГУ-27 (1С ЭТРАН)";
  описание "Документ накладной из системы 1С, интегрируемый через шину Datareon";
  позиция 0;

  // ========================================
  // Основные реквизиты накладной
  // ========================================

  реквизит ТипНакладнойНаименование {
    тип Строка;
    обмен Datareon.Package.waybill_type;
  }

  реквизит Номер {
    тип Строка;
    ключ primary;
    обмен Datareon.Package.waybill_number;
  }

  реквизит ИдентификаторНакладной {
    тип Строка;
    ключ unique;
    обмен Datareon.Package.waybill_identifier;
  }

  реквизит ВидОтправкиНаименование {
    тип Строка;
    обмен Datareon.Package.shipment_type;
  }

  реквизит СкоростьОтправкиНаименование {
    тип Строка;
    обмен Datareon.Package.shipment_speed;
  }

  реквизит ТипБланкаНаименование {
    тип Строка;
    обмен Datareon.Package.form_type;
  }

  // ========================================
  // Даты и сроки
  // ========================================

  реквизит ДатаИстеченияСрокаДоставки {
    тип Дата;
    обмен Datareon.Package.delivery_deadline;
  }

  реквизит ДатаСозданияДокумента {
    тип Дата;
    обмен Datareon.Package.waybill_created_at;
  }

  реквизит ДатаПредъявленияНакладной {
    тип Дата;
    обмен Datareon.Package.submitted_at;
  }

  реквизит ДатаСогласования {
    тип Дата;
    обмен Datareon.Package.approved_at;
  }

  реквизит ДатаПринятияПриемосдатчиком {
    тип Дата;
    обмен Datareon.Package.accepted_at;
  }

  реквизит ДатаИВремяПринятияГрузаКПеревозке {
    тип Дата;
    обмен Datareon.Package.cargo_accepted_at;
  }

  реквизит ДатаИВремяОтправленияГруза {
    тип Дата;
    обмен Datareon.Package.departure_at;
  }

  // ========================================
  // Станции отправления и назначения
  // ========================================

  реквизит СтранаОтправленияНаименование {
    тип Строка;
    обмен Datareon.Package.departure_country;
  }

  реквизит СтанцияОтправленияНаименование {
    тип Строка;
    обмен Datareon.Package.departure_station;
  }

  реквизит СтанцияОтправленияКод {
    тип Строка;
    обмен Datareon.Package.departure_station_code;
  }

  реквизит СтранаНазначенияНаименование {
    тип Строка;
    обмен Datareon.Package.destination_country;
  }

  реквизит СтанцияНазначенияНаименование {
    тип Строка;
    обмен Datareon.Package.destination_station;
  }

  реквизит СтанцияНазначенияКод {
    тип Строка;
    обмен Datareon.Package.destination_station_code;
  }

  // ========================================
  // Грузоотправитель
  // ========================================

  реквизит ГрузоотправительНаименование {
    тип Строка;
    обмен Datareon.Package.shipper_name;
  }

  реквизит ГрузоотправительАдрес {
    тип Строка;
    обмен Datareon.Package.shipper_address;
  }

  реквизит ГрузоотправительТГНЛ {
    тип Строка;
    обмен Datareon.Package.shipper_tgnl;
  }

  реквизит ГрузоотправительКодОКПО {
    тип Строка;
    обмен Datareon.Package.shipper_okpo;
  }

  // ========================================
  // Грузополучатель
  // ========================================

  реквизит ГрузополучательНаименование {
    тип Строка;
    обмен Datareon.Package.consignee_name;
  }

  реквизит ГрузополучательАдрес {
    тип Строка;
    обмен Datareon.Package.consignee_address;
  }

  реквизит ГрузополучательТГНЛ {
    тип Строка;
    обмен Datareon.Package.consignee_tgnl;
  }

  реквизит ГрузополучательКодОКПО {
    тип Строка;
    обмен Datareon.Package.consignee_okpo;
  }

  // ========================================
  // Плательщик и оплата
  // ========================================

  реквизит ПлательщикНаименование {
    тип Строка;
    обмен Datareon.Package.payer;
  }

  реквизит ПлательщикКод {
    тип Строка;
    обмен Datareon.Package.payer_code;
  }

  реквизит ФормаОплатыНаименование {
    тип Строка;
    обмен Datareon.Package.payment_form;
  }

  реквизит МестоОплатыНаименование {
    тип Строка;
    обмен Datareon.Package.payment_place;
  }

  // ========================================
  // Вагоны и прочее
  // ========================================

  реквизит ПлановыйТипСобственностиВагонаНаименование {
    тип Строка;
    обмен Datareon.Package.wagon_ownership_type;
  }

  реквизит ПланируемоеКоличествоВагонов {
    тип Число;
    обмен Datareon.Package.planned_wagons;
  }

  реквизит ОтветственныйЗаЗаполнение {
    тип Строка;
    обмен Datareon.Package.responsible_person;
  }

  // ========================================
  // Табличные части (коллекции)
  // ========================================

  реквизит Грузы {
    тип Документ.акс_Накладная.Грузы.СтрокаТабличнойЧасти[];
    обмен Datareon.Package.products;
  }

  реквизит Вагоны {
    тип Документ.акс_Накладная.Вагоны[];
    обмен Datareon.Package.railway_carriages;
  }

  реквизит СпециальныеОтметки {
    тип Документ.акс_Накладная.СпециальныеОтметки[];
    обмен Datareon.Package.special_marks;
  }

  реквизит ТарифныеОтметкиЗаОтправку {
    тип Документ.акс_Накладная.ТарифныеОтметки.СтрокаТабличнойЧасти[];
    обмен Datareon.Package.tariff_marks;
  }
}

