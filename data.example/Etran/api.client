api ETRAN.API.client {
  description "API для работы с накладными на клиенте";

  // Импорт измененных DTO
  import ALIS/dto/Container;
  import ALIS/dto/EtsngCode;
  import ALIS/dto/RailwayStation;
  import ALIS/dto/RailwayCarriage;
  import ALIS/dto/Zpu;

  // Импорт Response DTO
  import ALIS/dto/Waybill;
  import ALIS/dto/WaybillProduct;
  import ALIS/dto/WaybillRailwayCarriage;
  import ALIS/dto/WaybillContainer;
  import ALIS/dto/WaybillSpecialMark;
  import ALIS/dto/WaybillTariffMark;
  import ALIS/dto/Zpu;

  /*
  // DTO.IdCode - Универсальный DTO для справочников
  dto DTO.IdCode {
    description "Универсальный DTO";
  
    attribute id {
      type uuid;
    }
  
    attribute code {
      type string;
    }
  }
  */

  // ========================================
  // Накладные
  // ========================================
  endpoint getGroupedWaybillsPage {
    label "POST /waybill/grouped/page";
    description "Получить страницу с сгруппированными накладными";
    
    attribute response {
      type DTO.WaybillGrouped[];
    }
  }

  endpoint getWaybillById {
    label "GET /waybill/{id}";
    description "Получить конкретную накладную";
    
    attribute response {
      type DTO.WaybillDetailed;
    }
  }

  // ========================================
  // Грузы
  // ========================================
  endpoint getWaybillProductsPage {
    label "POST /waybill-product/page";
    description "Получить страницу с грузами накладных";
    
    attribute response {
      type DTO.WaybillProduct[];
    }
  }

  endpoint getWaybillProductById {
    label "GET /waybill-product/{id}";
    description "Получить конкретный груз";
    
    attribute response {
      type DTO.WaybillProductDetailed;
    }
  }

  // ========================================
  // Вагоны
  // ========================================
  endpoint getWaybillRailwayCarriagesPage {
    label "POST /waybill-railway-carriage/page";
    description "Получить страницу с вагонами накладных";
    
    attribute response {
      type DTO.WaybillRailwayCarriage[];
    }
  }

  endpoint getWaybillRailwayCarriageById {
    label "GET /waybill-railway-carriage/{id}";
    description "Получить конкретный вагон накладной";
    
    attribute response {
      type DTO.WaybillRailwayCarriageDetailed;
    }
  }

  // ========================================
  // КТК
  // ========================================
  endpoint getWaybillContainersPage {
    label "POST /waybill-container/page";
    description "Получить страницу с КТК накладных";
    
    attribute response {
      type DTO.WaybillContainer[];
    }
  }

  // ========================================
  // Специальные отметки
  // ========================================
  endpoint getWaybillSpecialMarksPage {
    label "POST /waybill-special-mark/page";
    description "Получить страницу со специальными отметками";
    
    attribute response {
      type DTO.WaybillSpecialMark[];
    }
  }

  // ========================================
  // Тарифные отметки
  // ========================================
  endpoint getWaybillTariffMarksPage {
    label "POST /waybill-tariff-mark/page";
    description "Получить страницу с тарифными отметками";
    
    attribute response {
      type DTO.WaybillTariffMark[];
    }
  }
}
