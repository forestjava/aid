// Образец того, как реализована Иерархия номенклатуры в WMS
сущность WMS.Справочник.Номенклатура {
  label "1C:Справочник.Номенклатура"; 
  rank 3;
  
  // Стандантные реквизиты 1С
  реквизит Код {
    тип Строка;
  }
  
  реквизит Наименование {
    тип Строка;
  }

  // Ключ для синхронизации с другими системами
  реквизит sync_id {
    тип Строка;
    обмен client_good.sync_id {
      используя ЭтоГруппа Ложь;
      клон Элемент;
    };
    обмен good_group.sync_id {
      используя ЭтоГруппа Истина;
      клон Группа;
    };
  }
  
  // Ссылка на родительский элемент
  реквизит Родитель {
    тип WMS.Справочник.Номенклатура(Группа);
  }
  
  // Возможность получать дочерние элементы 
  метод Дочерние.Элементы {
    тип WMS.Справочник.Номенклатура(Элемент)[];
  }

  // Возможность получать дочерние группы 
  метод Дочерние.Группы {
    тип WMS.Справочник.Номенклатура(Группа)[];
  }

  // Признак того, является ли данны элемент групповым или терминальным в иерархии
  метод ЭтоГруппа {
    тип Булево;
  }
} 
