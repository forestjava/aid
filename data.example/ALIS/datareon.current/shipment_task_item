dto Datareon.ShipmentTaskItem {
  source "web-layer/src/main/java/ru/korusconsulting/alis/datareon/dto/shipping/shipmenttask/ShipmentTaskItemDto.java";

  attribute _item {
    type UUID;
    sync ALIS.ShippingOrderGood.clientGood.syncId {
      using deliveryType "BY_GOOD";
      clone BY_GOOD;
    }
    sync ALIS.ShippingOrderCargo.shippingOrderGood.clientGood.syncId {
      using deliveryType "BY_GOOD_WITH_CARGO_WITH_DETAILS";
      clone BY_GOOD_WITH_CARGO_WITH_DETAILS;
    }
    sync ALIS.ShippingOrder.deliveryType {
      using ALIS.ShippingOrder.deliveryType "BY_CARGO";
      const "00000000-0000-0000-0000-000000000000";
      clone BY_CARGO;
    }
  }

  attribute _package {
    type UUID;
    sync ALIS.GoodPackage.syncId {
      using clientGood ALIS.ShippingOrderGood.clientGood;
      using deliveryType "BY_GOOD";
      clone BY_GOOD;
    }
    sync ALIS.ShippingOrderCargo.goodPackage.syncId {
      using deliveryType "BY_GOOD_WITH_CARGO_WITH_DETAILS";
      clone BY_GOOD_WITH_CARGO_WITH_DETAILS;
    }
    sync ALIS.ShippingOrder.deliveryType {
      using ALIS.ShippingOrder.deliveryType "BY_CARGO";
      const "00000000-0000-0000-0000-000000000000";
      clone BY_CARGO;
    }
  }

  attribute status {
    type String;
  }

  attribute cargoNumber {
    type String;
    sync ALIS.ShippingOrderBlackbox.cargo.code {
      using deliveryType "BY_CARGO";
      clone BY_CARGO;
    }
    sync ALIS.ShippingOrderCargo.cargo.code {
      using deliveryType "BY_GOOD_WITH_CARGO_WITH_DETAILS";
      clone BY_GOOD_WITH_CARGO_WITH_DETAILS;
    }
  }

  attribute batch {
    type Datareon.ShipmentTaskItemBatch;
  }

  attribute pkgQty {
    type BigDecimal;
    sync ALIS.ShippingOrderGood.plannedQuantity {
      using deliveryType "BY_GOOD";
      clone BY_GOOD;
    }
    sync ALIS.ShippingOrderCargo.packageQuantity {
      using deliveryType "BY_GOOD_WITH_CARGO_WITH_DETAILS";
      clone BY_GOOD_WITH_CARGO_WITH_DETAILS;
    }
  }

  attribute qty {
    type BigDecimal;
    sync ALIS.ShippingOrderGood.plannedQuantity {
      using deliveryType "BY_GOOD";
      clone BY_GOOD;
    }
    sync ALIS.ShippingOrderCargo.totalQuantity {
      using deliveryType "BY_GOOD_WITH_CARGO_WITH_DETAILS";
      clone BY_GOOD_WITH_CARGO_WITH_DETAILS;
    }
  }
}
