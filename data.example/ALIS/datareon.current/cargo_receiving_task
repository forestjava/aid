// Задание на приёмку (грузовая) -> 1С
dto Datareon.CargoReceivingTask {
  source "web-layer/src/main/java/ru/korusconsulting/alis/datareon/dto/receiving/cargoreceivingtask/CargoReceivingTaskDto.java";
  using messageType "CARGO_RECEIVING_TASK";
  route "/cargorec";

  attribute _id {
    type UUID;
    sync ALIS.OutboundData(CARGO_RECEIVING_TASK).rootObjectId;
  }

  attribute _transportManifest {
    type UUID;
    sync ALIS.ReceivingOrderContainer.receivingOrderRailwayCarriage.id {
      using entityType "RECEIVING_ORDER_CONTAINER";
    }
  }

  attribute _shipper {
    type UUID;
    sync ALIS.ReceivingOrderTransport.shipper.syncId {
      using entityType "RECEIVING_ORDER";
      clone RECEIVING_ORDER;
    }
    sync ALIS.ReceivingOrderTransport.shipper.syncId {
      using entityType "RECEIVING_ORDER_CONTAINER";
      using transportType "VEHICLE";
      clone VEHICLE;
    }
    sync ALIS.ReceivingOrderContainer.receivingOrderRailwayCarriage.etranInvoice.id {
      using entityType "RECEIVING_ORDER_CONTAINER";
      using transportType "RAILWAY";
      clone RAILWAY;
    }
  }

  // Рейс
  attribute route {
    type Datareon.RouteExport;

    attribute _id {
      type UUID;
      sync ALIS.ReceivingOrder.route.id;
    }

    attribute routeNumber {
      type Long;
      sync ALIS.ReceivingOrder.route.number;
    }

    attribute trainNumber {
      type String;
      sync ALIS.ReceivingOrder.route.comment;
    }
  }

  // Плановая дата (формат yyyy-MM-dd)
  attribute planningDate {
    type String;
    sync ALIS.ReceivingOrder.planReceivingDateTime;

  }

  // Плановое время (формат HH:mm)
  attribute planningTime {
    type String;
    sync ALIS.ReceivingOrder.planReceivingDateTime;

  }

  // Площадка
  attribute site {
    type String;
    sync ALIS.ReceivingOrder.terminalArea;
    translate TerminalArea;
  }

  // Заказ клиента
  attribute order {
    type Datareon.ClientOrder(RECEIVING);
  }

  // Грузы (зависит от entityType)
  attribute cargo {
    type Datareon.ReceivingTaskCargo[];
  }

  // Доп. услуги
  attribute service {
    type Datareon.ReceivingTaskService[];
  }
}
