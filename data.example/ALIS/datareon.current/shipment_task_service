dto Datareon.ShipmentTaskService {
  source "web-layer/src/main/java/ru/korusconsulting/alis/datareon/dto/shipping/shipmenttask/ShipmentTaskServiceDto.java";

  attribute operationType {
    type Datareon.ServiceOperationType;

    attribute _id {
      type UUID;
      sync ALIS.ShippingOrderRequestedService.termOfRequestedService.service.syncId;
    }

    attribute name {
      type String;
      sync ALIS.ShippingOrderRequestedService.termOfRequestedService.service.code;
    }
  }

  attribute qty {
    type Number;
    sync ALIS.ShippingOrderRequestedService.plannedQuantity;
  }

  attribute unit {
    type String;
    sync ALIS.ShippingOrderRequestedService.serviceOfMeasure;
  }

  attribute instruction {
    type String;
    const null;
  }
}
