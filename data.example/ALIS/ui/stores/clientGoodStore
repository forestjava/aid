store clientGoodStore {
   type Store;
   label "Стор товаров клиента";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type clientGoodData[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type full_client_good;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }

   method uploadFile {
     type jsonb;
   }

   method init {
     type void;
   }

   method getClientGoodsData {
     type blob;
   }

   method getAdditionalBlobData {
     type jsonb;
   }
}

json client {
  attribute id;
  attribute code;
}

json goodType {
  attribute id;
  attribute code;
}

json unitOfMeasure {
  attribute id;
  attribute code;
}

json clientGoodData {
  attribute item {
    type String;
  }

  attribute client {
    type client; 
  }

  attribute code {
    type String;
  }
  
  attribute goodType {
    type goodType; 
  }
  
  attribute unitOfMeasure{
    type unitOfMeasure;
  }
}