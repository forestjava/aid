store receivingOrderStore {
   type Store;
   label "Стор заказов на приемку";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type receivingOrderData[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type full_receiving_order;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }
}

json client {
  attribute id;
  attribute code;
  attribute name;
}

json route {
  attribute id;
  attribute code;
}

json receivingOrderData {
  attribute number{
  type number;
  map DTO.ReceivingOrderDto.number;
  }

  attribute client.code {
  type client;
  }

  attribute planReceivingDateTime {
  type Date;
  map DTO.ReceivingOrderDto.planReceivingDateTime;
  }

  attribute terminalArea {
  type enum;
  map DTO.ReceivingOrderDto.terminalArea;
  }

  attribute transportType {
  type enum;
  map DTO.ReceivingOrderDto.transportType;
  }

  attribute createdAt {
  type Date;
  map DTO.ReceivingOrderDto.createdAt;
  }

  attribute route.code {
  type route;
  }

  attribute orderStatus {
  type enum;
  map DTO.ReceivingOrderDto.orderStatus;
  }

  attribute documentConfirmed {
  type boolean;
  map DTO.ReceivingOrderDto.documentConfirmed;
  }

}