    id: types.identifier,
    code: types.string,
    name: types.string,
    inn: types.maybeNull(types.string),
    kpp: types.maybeNull(types.string),
    active: types.boolean,
});
*/

json Client {
  source "src\features\Client\store\ClientStore\ClientStore.ts";

  attribute id {
  type UUID;
  map DTO.ClientDto.id;
  }

  attribute code{
  type String;
  map DTO.ClientDto.name;
  }

  attribute inn {
  type String;
  map DTO.ClientDto.inn;
  }
  
  attribute kpp {
  type String;
  map DTO.ClientDto.kpp;
  }

  attribute active {
  type boolean;
  map DTO.ClientDto.active;
  }
}