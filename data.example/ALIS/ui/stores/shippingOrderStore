store ShippingOrderStore {
   type Store;
   label "Стор заказов на отгрузку";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type ShippingOrderData[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type full_shipping_order;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }
}

json client {
  attribute id;
  attribute code;
  attribute name;
}

json route {
  attribute id;
  attribute code;
}

json ShippingOrderData {
  attribute number{
    type number;
    map DTO.ShippingOrderDto.number;
  }

  attribute client.code {
  type client;
  }

  attribute terminalArea {
  type enum;
    map DTO.ShippingOrderDto.terminalArea;
  }

  attribute transportType {
  type enum;
    map DTO.ShippingOrderDto.transportType;
  }

  attribute createdAt {
  type enum;
    map DTO.ShippingOrderDto.createdAt;
  }

  attribute route.code {
  type route;
  }

  attribute orderStatus {
  type enum;
    map DTO.ShippingOrderDto.orderStatus;
  }

  attribute plannedShippingDateTime {
  type Date;
    map DTO.ShippingOrderDto.plannedShippingDateTime;
  }
}