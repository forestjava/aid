store roleStore {
   type Store;
   label "Стор ролей";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type roleData[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type full_role;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }
}

json roleData {
  attribute name{
  type String;
  }

  attribute description {
  type String;
  }

}