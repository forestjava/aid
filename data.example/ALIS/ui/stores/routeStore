store routeStore {
   type Store;
   label "Стор рейсов";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type Route[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type route_full;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }

   method getRoutesData {
     type blob;
   }

   method getAdditionalBlobData {
     type jsonb;
   }
}

json Route {
  source "src\features\Routes\models\Route.model.ts";

  attribute id {
    type UUID;
    map DTO.RouteDto.id;
  }

  attribute number {
    type Number;
    map DTO.RouteDto.number;
  }

  attribute routeType {
    type String;
    map DTO.RouteDto.routeType;
  }

  attribute dataTime {
    type String;
    map DTO.RouteDto.dataTime;
  }

  attribute terminalArea {
    type String;
    map DTO.RouteDto.terminalArea;
  }

  attribute transportType {
    type String;
    map DTO.RouteDto.transportType;
  }

  attribute clientRelatedEntity {
    type clientRelatedEntity;
    map DTO.RouteDto.clientRelatedEntity;
  }

  attribute clientDriver {
    type clientDriver;
    map DTO.RouteDto.clientDriver;
  }

  attribute clientVehicle {
    type clientVehicle;
    map DTO.RouteDto.clientVehicle;
  }

  attribute comment {
    type String;
    map DTO.RouteDto.comment;
  }

  attribute status {
    type String;
    map DTO.RouteDto.status;
  }

  attribute shippingOrders {
    type idNumber[];
    map DTO.RouteDto.shippingOrders;
  }

  attribute receivingOrders {
    type idNumber[];
    map DTO.RouteDto.receivingOrders;
  }
}

json route_full {
  source "src\features\Routes\models\FullRoute.model.ts";

  attribute id {
    type UUID;
    map DTO.RouteDetailedDto.id;
  }

  attribute number {
    type Number;
    map DTO.RouteDetailedDto.number;
  }

  attribute routeType {
    type String;
    map DTO.RouteDetailedDto.routeType;
  }

  attribute dataTime {
    type String;
    map DTO.RouteDetailedDto.dataTime;
  }

  attribute terminalArea {
    type String;
    map DTO.RouteDetailedDto.terminalArea;
  }

  attribute transportType {
    type String;
    map DTO.RouteDetailedDto.transportType;
  }

  attribute clientRelatedEntity {
    type clientRelatedEntity;
    map DTO.RouteDetailedDto.clientRelatedEntity;
  }

  attribute clientDriver {
    type clientDriverShort;
    map DTO.RouteDetailedDto.clientDriver;
  }

  attribute clientVehicle {
    type clientVehicleShort;
    map DTO.RouteDetailedDto.clientVehicle;
  }

  attribute comment {
    type String;
    map DTO.RouteDetailedDto.comment;
  }

  attribute status {
    type String;
    map DTO.RouteDetailedDto.status;
  }

  attribute routeOrders {
    type jsonb;
  }

  attribute RouteActionButtonsStore {
    type jsonb;
  }
}
