store containerStore {
   type Store;
   label "Стор контейнеров";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type containerData[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type full_data_container;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }

   method getContainerInfoXlsx {
     type blob;
   }
}

json standardSize {
  attribute id;
  attribute code;
}

json containerData {
  attribute code{
  type String;
  map DTO.ContainerDto.code;
  }

  attribute standardSize.code {
  type standardSize;
  map DTO.ContainerDto.standardSize;
  }

  attribute liftingCapacity {
  type number;
  map DTO.ContainerDto.liftingCapacity;
  }

}