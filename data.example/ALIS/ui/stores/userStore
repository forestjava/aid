store userStore {
   type Store;
   label "Стор пользователей";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type userData[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type full_user;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }

   method getUserData {
     type blob;
   }

   method getAdditionalBlobData {
     type jsonb;
   }
}


json userData {
  attribute username{
  type String;
  }

  attribute fullName {
  type String;
  }

  attribute type {
  type enum;
  }

  attribute active {
  type boolean;
  }
}