store serviceStore {
   type Store;
   label "Стор услуг";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type serviceData[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type full_service;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }

   method getServicesData {
     type blob;
   }

   method getAdditionalBlobData {
     type jsonb;
   }
}

json serviceData {
  attribute code{
  type String;
  map DTO.ServiceDto.code;
  }

  attribute serviceOfMeasure {
  type enum;
  map DTO.ServiceDto.serviceOfMeasure;
  }

  attribute terminalArea {
  type enum;
  map DTO.ServiceDto.terminalArea;
  }

  attribute active {
  type boolean;
  map DTO.ServiceDto.active;
  }

  attribute accrualMethod {
  type enum;
  map DTO.ServiceDto.accrualMethod;
  }

  attribute accrualBase {
  type enum;
  map DTO.ServiceDto.accrualBase;
  }



}