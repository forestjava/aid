store unitOfMeasureStore {
   type Store;
   label "Стор единиц измерения";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type unitOfMeasure[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type unit_of_measure;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }
}


json unitOfMeasure {
  source "src\features\UnitOfMeasure\store\UnitOfMeasureStore\UnitOfMeasureStore.ts";

    attribute id {
    type UUID;
    is nullable;
    key primary;
    map DTO.UnitOfMeasure.id;
  }

  attribute code {
    type varchar(200);
    is nullable;
    map DTO.UnitOfMeasure.code;
  }

  attribute name {
    type varchar(500);
    is nullable;
    map DTO.UnitOfMeasure.name;
  }

  attribute active {
    type boolean;
    is required;
    map DTO.UnitOfMeasure.active;
  }

  attribute codeOkei {
    type varchar(500);
    is nullable;
    map DTO.UnitOfMeasure.codeOkei;
  }
}