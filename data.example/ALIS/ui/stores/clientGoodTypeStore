store clientGoodTypeStore {
   type Store;
   label "Стор типов товаров клиента";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type clientGoodData[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type client_good_type;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }

   method getClientGoodTypesData {
     type blob;
   }

   method getAdditionalBlobData {
     type jsonb;
   }
}

 json client {
 map DTO.ClientGoodTypeDto.client;
  attribute id {
  type String;
  }

  attribute code {
  type String;
  }
}

json clientGoodData {
  attribute clientSyncId{
  type String;
  map DTO.ClientGoodTypeDto.clientSyncId;
  }

  attribute client.code {
  type client;
  map DTO.ClientGoodTypeDto.client;
  }

  attribute code {
  type String;
  map DTO.ClientGoodTypeDto.code;
  }

  attribute active {
  type boolean;
  map DTO.ClientGoodTypeDto.active;
  }
}