store clientDriverStore {
   type Store;
   label "Стор водителей клиента";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type ClientDriver[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type full_client_driver;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }

   method getClientDriversData {
     type blob;
   }

   method getAdditionalBlobData {
     type jsonb;
   }
}

json ClientDriver{
  source "src/features/ClientDriverTable/store/ClientDriverStore.tsx";

  attribute id {
  type UUID;
  map DTO.ClientDriverDto.id;
  }

  attribute passportNumber{
  type String;
  map DTO.ClientDriverDto.passportNumber;
  }

  attribute code {
  type String;
  map DTO.ClientDriverDto.code;
  }

  attribute client {
  type client;
  map DTO.ClientDriverDto.client;
  }

  attribute phoneNumber {
  type String;
  map DTO.ClientDriverDto.phoneNumber;
  }

  attribute active {
  type boolean;
  map DTO.ClientDriverDto.active;
  }
}

json client{
  attribute code {
  type String;
  }

  attribute id {
  type String;
  }
} 