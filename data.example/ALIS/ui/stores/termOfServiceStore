store termOfServiceStore {
   type Store;
   label "Стор условий обслуживания";
   
   attribute state {
     type store_state;
     is required;
   }

   attribute data {
     type termOfServiceData[];
     is required;
   }

   attribute pagination {
     type pagination;
     is required;
   }

   attribute sorting {
     type sorting;
     is required;
   }

   attribute current {
     type full_term_of_service;
     is nullable;
   }

   attribute previous_filters {
     type jsonb;
     is nullable;
   }

   attribute suffix_url {
     type varchar(200);
     is nullable;
   }

   method getById {
     type model;
   }

   method fetch {
     type void;
   }

   method fetchWithUrlQuery {
     type void;
   }

   method update {
     type model;
   }

   method create {
     type model;
   }

   method remove {
     type void;
   }

   method setCurrent {
     type void;
   }

   method paginationChanged {
     type void;
   }

   method sortingChanged {
     type void;
   }

   method getTermOfServicesData {
     type blob;
   }

   method getAdditionalBlobData {
     type jsonb;
   }
}

json client {
  attribute id;
  attribute code;
}

json contract {
  attribute id;
  attribute code;
}

json termOfServiceData {
  attribute code{
  type String;
  }

  attribute client.code {
  type client;
  }

  attribute contract.code {
  type contract;
  }

  attribute terminalArea {
  type enum;
  }

  attribute validFrom {
  type Date;
  }

  attribute validTo {
  type Date;
  }

  attribute status {
  type boolean;
  }
}