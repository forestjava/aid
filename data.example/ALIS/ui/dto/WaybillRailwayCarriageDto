dto DTO.WaybillRailwayCarriageDto {
  type Table;
  label "Железнодорожный вагон накладной";

  attribute id {
    type UUID;
    is required;
    key primary;
  }

  attribute ownership {
    type varchar(500);
    is nullable;
  }

  attribute previouslyTransported {
    type varchar(500);
    is nullable;
  }

  method railwayCarriage {
    type railwayCarriage;
  }

  attribute createdAt {
    type timestamp;
    is required;
  }

  attribute updatedAt {
    type timestamp;
    is nullable;
  }

  attribute createdBy {
    type varchar(50);
    is required;
  }

  attribute updatedBy {
    type varchar(50);
    is nullable;
  }
}
