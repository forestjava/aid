dto DTO.UserGroupDto {
  type Table;
  label "Группа пользователей";

  attribute id {
    type UUID;
    is required;
    key primary;
  }

  attribute name {
    type varchar(500);
    is nullable;
  }

  attribute description {
    type text;
    is nullable;
  }

  attribute createdAt {
    type timestamp;
    is required;
  }

  attribute updatedAt {
    type timestamp;
    is nullable;
  }

  attribute createdBy {
    type varchar(50);
    is required;
  }

  attribute updatedBy {
    type varchar(50);
    is nullable;
  }
}
