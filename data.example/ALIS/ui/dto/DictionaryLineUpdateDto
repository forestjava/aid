dto DTO.DictionaryLineUpdateDto {
  type Table;
  label "DTO обновления строки справочника";

  attribute id {
    type UUID;
    is required;
    key primary;
  }

  attribute code {
    type varchar(200);
    is required;
  }

  attribute active {
    type boolean;
    is nullable;
  }

  attribute name {
    type varchar(500);
    is nullable;
  }

  method dictionary {
    type id;
  }

  method dictionaryLineParameters {
    type dictionaryLineParameterUpdate[];
  }
}
