dto DTO.ContractUpdateDto {
  type Table;
  label "DTO обновления договора";

  attribute id {
    type UUID;
    is required;
    key primary;
  }

  attribute code {
    type varchar(200);
    is required;
  }

  attribute name {
    type varchar(500);
    is nullable;
  }

  attribute active {
    type boolean;
    is nullable;
  }

  attribute syncId {
    type UUID;
    is nullable;
  }

  attribute edoId {
    type varchar(500);
    is nullable;
  }

  attribute contractNumber {
    type varchar(500);
    is required;
  }

  attribute contractDate {
    type timestamp;
    is nullable;
  }

  attribute validFrom {
    type timestamp;
    is nullable;
  }

  attribute validTo {
    type timestamp;
    is nullable;
  }

  attribute contractType {
    type varchar(50);
    is required;
  }

  method client {
    type id;
  }

  method company {
    type id;
  }

  method currency {
    type id;
  }
}
