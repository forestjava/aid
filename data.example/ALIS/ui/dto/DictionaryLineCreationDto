dto DTO.DictionaryLineCreationDto {
  type Table;
  label "DTO создания строки справочника";

  attribute code {
    type varchar(200);
    is required;
  }

  attribute active {
    type boolean;
    is nullable;
  }

  attribute name {
    type varchar(500);
    is nullable;
  }

  method dictionary {
    type id;
  }

  method dictionaryLineParameters {
    type dictionaryLineParameterCreation[];
  }
}
