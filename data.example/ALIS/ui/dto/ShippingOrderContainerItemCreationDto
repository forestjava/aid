dto DTO.ShippingOrderContainerItemCreationDto {
  type Interface;
  label "Элемент контейнера заказа на отгрузку создание";

  attribute description {
    type text;
    is nullable;
  }

  attribute price {
    type numeric;
    is nullable;
  }

  attribute wightGross {
    type numeric;
    is required;
  }

  attribute wightNet {
    type numeric;
    is nullable;
  }

  attribute quantityPlace {
    type numeric;
    is nullable;
  }

  method shippingOrder {
    type id;
  }

  method shippingOrderContainer {
    type id;
  }

  method etsngCode {
    type id;
  }
}
