dto DTO.TermOfPeriodicServiceCreationDto {
  type Table;
  label "Условие периодической услуги создание";

  attribute code {
    type varchar(200);
    is required;
  }

  attribute active {
    type boolean;
    is nullable;
  }

  attribute name {
    type varchar(500);
    is nullable;
  }

  attribute syncId {
    type UUID;
    is required;
  }

  attribute rate {
    type numeric;
    is required;
  }

  method service {
    type id;
  }

  method termOfService {
    type id;
  }

  method frequencyOfServices {
    type id;
  }
}
