dto DTO.GoodPackageBarcodeDto {
  type Table;
  label "Штрихкод упаковки товара";

  attribute id {
    type UUID;
    is nullable;
    key primary;
  }

  attribute code {
    type varchar(200);
    is nullable;
  }

  attribute active {
    type boolean;
    is nullable;
  }

  attribute syncId {
    type UUID;
    is nullable;
  }

  method goodPackage {
    type goodPackage;
  }

  method clientGood {
    type clientGood;
  }

  attribute createdAt {
    type timestamp;
    is required;
  }

  attribute updatedAt {
    type timestamp;
    is nullable;
  }

  attribute createdBy {
    type varchar(50);
    is required;
  }

  attribute updatedBy {
    type varchar(50);
    is nullable;
  }
}
