dto DTO.EtranInvoiceDto {
  type Table;
  label "ЭТРАН накладная";

  attribute id {
    type UUID;
    is nullable;
    key primary;
  }

  attribute code {
    type varchar(200);
    is nullable;
  }

  attribute active {
    type boolean;
    is nullable;
  }

  attribute createdInEtran {
    type boolean;
    is nullable;
  }

  attribute isForReceivingOrder {
    type boolean;
    is nullable;
  }

  attribute transportationType {
    type varchar(50);
    is nullable;
  }

  method client {
    type client;
  }

  method shipper {
    type shipper;
  }

  method consigneeCompany {
    type consigneeCompany;
  }

  method consigneeClient {
    type consigneeClient;
  }

  method departureStation {
    type departureStation;
  }

  method destinationStation {
    type destinationStation;
  }

  attribute createdAt {
    type timestamp;
    is required;
  }

  attribute updatedAt {
    type timestamp;
    is nullable;
  }

  attribute createdBy {
    type varchar(50);
    is required;
  }

  attribute updatedBy {
    type varchar(50);
    is nullable;
  }
}
