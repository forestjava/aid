dto DTO.ReceivingOrderContainerCreationDto {
  type Interface;
  label "Контейнер заказа на приемку создание";

  attribute sealNumbers {
    type varchar(50)[];
    is nullable;
  }

  attribute empty {
    type boolean;
    is required;
  }

  attribute customsClearance {
    type boolean;
    is nullable;
  }

  attribute ktkNumberUnknown {
    type boolean;
    is nullable;
  }

  method receivingOrder {
    type id;
  }

  method receivingOrderRailwayCarriage {
    type id;
  }

  method container {
    type id;
  }

  method sealType {
    type id;
  }

  method dangerClass {
    type id;
  }

  method ownerContainer {
    type ownerContainer;
  }
}
