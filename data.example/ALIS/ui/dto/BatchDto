dto DTO.BatchDto {
  type Table;
  label "Партия";

  attribute id {
    type UUID;
    is nullable;
    key primary;
  }

  attribute code {
    type varchar(200);
    is nullable;
  }

  attribute active {
    type boolean;
    is nullable;
  }

  attribute variant {
    type UUID;
    is nullable;
  }

  attribute manufactureDate {
    type timestamp;
    is nullable;
  }

  attribute expirationDate {
    type timestamp;
    is nullable;
  }

  attribute batchBarcode {
    type varchar(500);
    is nullable;
  }

  attribute batchAccountingType {
    type varchar(50);
    is nullable;
  }

  method client {
    type client;
  }

  method clientGood {
    type clientGood;
  }

  attribute createdAt {
    type timestamp;
    is required;
  }

  attribute updatedAt {
    type timestamp;
    is nullable;
  }

  attribute createdBy {
    type varchar(50);
    is required;
  }

  attribute updatedBy {
    type varchar(50);
    is nullable;
  }
}
