dto DTO.ClientGoodTypeUpdateDto {
  type Table;
  label "DTO обновления типа товара клиента";

  attribute id {
    type UUID;
    is required;
    key primary;
  }

  attribute code {
    type varchar(200);
    is required;
  }

  attribute active {
    type boolean;
    is nullable;
  }

  attribute name {
    type varchar(500);
    is nullable;
  }

  attribute syncId {
    type UUID;
    is required;
  }

  attribute clientSyncId {
    type varchar(500);
    is nullable;
  }

  attribute isVariable {
    type boolean;
    is required;
  }

  method client {
    type id;
  }
}
