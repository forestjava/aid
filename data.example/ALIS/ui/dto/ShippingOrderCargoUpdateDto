dto DTO.ShippingOrderCargoUpdateDto {
  type Table;
  label "Груз заказа на отгрузку обновление";

  attribute id {
    type UUID;
    is required;
    key primary;
  }

  attribute packageQuantity {
    type numeric;
    is nullable;
  }

  attribute totalQuantity {
    type numeric;
    is nullable;
  }

  attribute length {
    type numeric;
    is nullable;
  }

  attribute width {
    type numeric;
    is nullable;
  }

  attribute height {
    type numeric;
    is nullable;
  }

  attribute volume {
    type numeric;
    is nullable;
  }

  attribute weight {
    type numeric;
    is nullable;
  }

  method shippingOrder {
    type id;
  }

  method shippingOrderGood {
    type id;
  }

  method barcode {
    type id;
  }

  method batch {
    type id;
  }

  method goodPackage {
    type id;
  }

  method cargo {
    type id;
  }
}
