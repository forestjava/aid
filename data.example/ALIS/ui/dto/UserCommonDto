dto DTO.UserCommonDto {
  type Table;
  label "Общий DTO пользователя";

  attribute id {
    type UUID;
    is nullable;
    key primary;
  }

  attribute active {
    type boolean;
    is nullable;
  }

  attribute username {
    type varchar(500);
    is nullable;
  }

  attribute fullName {
    type varchar(500);
    is nullable;
  }

  attribute type {
    type varchar(50);
    is nullable;
  }

  attribute readOnly {
    type boolean;
    is nullable;
  }
}
