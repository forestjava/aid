dto DTO.TermOfServiceCreationDto {
  type Table;
  label "Условие услуги создание";

  attribute code {
    type varchar(200);
    is required;
  }

  attribute active {
    type boolean;
    is nullable;
  }

  attribute name {
    type varchar(500);
    is nullable;
  }

  attribute validFrom {
    type timestamp;
    is required;
  }

  attribute validTo {
    type timestamp;
    is nullable;
  }

  attribute indefinitely {
    type boolean;
    is required;
  }

  attribute terminalArea {
    type varchar(50);
    is required;
  }

  method contract {
    type id;
  }
}
