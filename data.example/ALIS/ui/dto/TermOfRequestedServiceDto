dto DTO.TermOfRequestedServiceDto {
  type Table;
  label "Условие запрашиваемой услуги";

  attribute id {
    type UUID;
    is required;
    key primary;
  }

  attribute syncId {
    type UUID;
    is nullable;
  }

  attribute required {
    type boolean;
    is nullable;
  }

  attribute rate {
    type numeric;
    is nullable;
  }

  attribute serviceOfMeasure {
    type varchar(50);
    is nullable;
  }

  attribute clientOrderType {
    type varchar(50);
    is nullable;
  }

  attribute calculationMethod {
    type varchar(50);
    is nullable;
  }

  method termOfService {
    type termOfService;
  }

  method service {
    type service;
  }

  attribute createdAt {
    type timestamp;
    is required;
  }

  attribute updatedAt {
    type timestamp;
    is nullable;
  }

  attribute createdBy {
    type varchar(50);
    is required;
  }

  attribute updatedBy {
    type varchar(50);
    is nullable;
  }
}
