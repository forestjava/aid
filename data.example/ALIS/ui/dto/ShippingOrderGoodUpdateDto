dto DTO.ShippingOrderGoodUpdateDto {
  type Table;
  label "Товар заказа на отгрузку обновление";

  attribute id {
    type UUID;
    is required;
    key primary;
  }

  attribute plannedQuantity {
    type numeric;
    is required;
  }

  attribute price {
    type numeric;
    is required;
  }

  attribute totalPrice {
    type numeric;
    is required;
  }

  method shippingOrder {
    type id;
  }

  method clientGood {
    type id;
  }

  method batch {
    type id;
  }
}
