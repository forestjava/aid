dto DTO.GoodTypeDto {
  type Table;
  label "Тип товара";

  attribute id {
    type UUID;
    is required;
    key primary;
  }

  attribute code {
    type varchar(200);
    is required;
  }

  attribute active {
    type boolean;
    is required;
  }

  attribute name {
    type varchar(500);
    is nullable;
  }

  attribute syncId {
    type UUID;
    is nullable;
  }

  attribute createdAt {
    type timestamp;
    is required;
  }

  attribute updatedAt {
    type timestamp;
    is nullable;
  }

  attribute createdBy {
    type varchar(50);
    is required;
  }

  attribute updatedBy {
    type varchar(50);
    is nullable;
  }
}
