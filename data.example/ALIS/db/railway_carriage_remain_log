table alis.railway_carriage_remain_log {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute status {
    type varchar(50);
    is required;
  }

  attribute start_time {
    type timestamp;
    is required;
  }

  attribute end_time {
    type timestamp;
  }

  attribute statistic {
    type text;
  }
}
