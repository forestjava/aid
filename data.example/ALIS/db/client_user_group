table alis.client_user_group {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute group_id {
    type uuid;
    is required;
  }

  attribute client_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.client.id;
    }
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }

  attribute updated_at {
    type timestamp;
  }

  attribute updated_by {
    type varchar(50);
  }
}
