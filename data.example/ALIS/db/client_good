table alis.client_good {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute code {
    type varchar(100);
    is required;
  }

  attribute name {
    type varchar(255);
  }

  attribute active {
    type boolean;
    is required;
  }

  attribute sync_id {
    type uuid;
    is required;
  }

  attribute item {
    type varchar(50);
  }

  attribute unit_of_measure_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.unit_of_measure.id;
    }
  }

  attribute good_type_id {
    type uuid;
    key foreign {
      attribute alis.good_type.id;
    }
  }

  attribute client_good_type_id {
    type uuid;
    key foreign {
      attribute alis.client_good_type.id;
    }
  }

  attribute gtin {
    type varchar(50);
  }

  attribute shelf_life {
    type numeric(9);
  }

  attribute danger_class_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.danger_class.id;
    }
  }

  attribute temp_regime_id {
    type uuid;
    key foreign {
      attribute alis.temp_regime.id;
    }
  }

  attribute price {
    type numeric(19,2);
    is required;
  }

  attribute description {
    type varchar(1000);
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }

  attribute updated_at {
    type timestamp;
  }

  attribute updated_by {
    type varchar(50);
  }

  attribute batch_accounting_type {
    type varchar(100);
    is required;
  }

  attribute serial_accounting_type {
    type varchar(100);
    is required;
  }

  attribute used_in_orders {
    type boolean;
    is required;
  }

  attribute code_kis {
    type varchar(8);
    is required;
  }

  attribute client_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.client.id;
    }
  }

  attribute good_group_id {
    type uuid;
    key foreign {
      attribute alis.good_group.id;
    }
  }
}
