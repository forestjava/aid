table alis.container_movement {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute order_id {
    type uuid;
    is required;
  }

  attribute container_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.container.id;
    }
  }

  attribute event_code {
    type varchar(20);
    is required;
  }

  attribute event_date_time {
    type timestamp;
    is required;
  }

  attribute transport_type {
    type varchar(100);
    is required;
  }

  attribute transport_number {
    type varchar(50);
    is required;
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }

  attribute updated_at {
    type timestamp;
  }

  attribute updated_by {
    type varchar(50);
  }

  attribute active {
    type boolean;
    is required;
  }

  attribute document_id {
    type uuid;
    is required;
  }
}
