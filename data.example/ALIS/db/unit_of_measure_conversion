table alis.unit_of_measure_conversion {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute active {
    type boolean;
    is required;
  }

  attribute from_unit_of_measure_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.unit_of_measure.id;
    }
  }

  attribute to_unit_of_measure_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.unit_of_measure.id;
    }
  }

  attribute conversion_rate {
    type numeric(22,9);
    is required;
  }

  attribute updated_at {
    type timestamp;
  }

  attribute updated_by {
    type varchar(50);
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }
}
