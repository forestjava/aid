table alis.etran_invoice {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute code {
    type varchar(100);
    is required;
  }

  attribute active {
    type boolean;
    is required;
  }

  attribute shipper_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.client_related_entity.id;
    }
  }

  attribute departure_station_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.railway_station.id;
    }
  }

  attribute destination_station_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.railway_station.id;
    }
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }

  attribute updated_at {
    type timestamp;
  }

  attribute updated_by {
    type varchar(50);
  }

  attribute transportation_type {
    type varchar(50);
    is required;
  }

  attribute consignee_company_id {
    type uuid;
    key foreign {
      attribute alis.company.id;
    }
  }

  attribute client_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.client.id;
    }
  }

  attribute created_in_etran {
    type boolean;
    is required;
  }

  attribute consignee_client_id {
    type uuid;
    key foreign {
      attribute alis.client.id;
    }
  }

  attribute is_for_receiving_order {
    type boolean;
    is required;
  }
}
