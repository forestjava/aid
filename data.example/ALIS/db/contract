table alis.contract {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute code {
    type varchar(100);
    is required;
  }

  attribute name {
    type varchar(255);
  }

  attribute active {
    type boolean;
    is required;
  }

  attribute sync_id {
    type uuid;
    is required;
  }

  attribute client_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.client.id;
    }
  }

  attribute company_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.company.id;
    }
  }

  attribute currency_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.currency.id;
    }
  }

  attribute contract_number {
    type varchar(50);
  }

  attribute contract_date {
    type timestamp;
  }

  attribute valid_from {
    type timestamp;
  }

  attribute valid_to {
    type timestamp;
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }

  attribute updated_at {
    type timestamp;
  }

  attribute updated_by {
    type varchar(50);
  }

  attribute edo_id {
    type varchar(50);
  }

  attribute contract_type {
    type varchar(20);
    is required;
  }
}
