table alis.client_good_type {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute code {
    type varchar(100);
    is required;
  }

  attribute name {
    type varchar(255);
  }

  attribute active {
    type boolean;
    is required;
  }

  attribute sync_id {
    type uuid;
    is required;
  }

  attribute client_sync_id {
    type varchar(50);
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }

  attribute updated_at {
    type timestamp;
  }

  attribute updated_by {
    type varchar(50);
  }

  attribute is_variable {
    type boolean;
    is required;
  }

  attribute has_client_goods {
    type boolean;
    is required;
  }

  attribute client_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.client.id;
    }
  }
}
