table alis.transport_package {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute barcode {
    type varchar(200);
    is required;
  }

  attribute unit_of_measure_id {
    type uuid;
    is required;
    key foreign {
      attribute alis.unit_of_measure.id;
    }
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }

  attribute updated_at {
    type timestamp;
  }

  attribute updated_by {
    type varchar(50);
  }
}
