table alis.product_type {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute code {
    type varchar(128);
    is required;
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }

  attribute updated_at {
    type timestamp;
  }

  attribute updated_by {
    type varchar(50);
  }
}
