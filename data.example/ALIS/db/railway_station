table alis.railway_station {

  attribute id {
    type uuid;
    is required;
    key primary;
  }

  attribute code {
    type varchar(100);
    is required;
  }

  attribute active {
    type boolean;
    is required;
  }

  attribute created_at {
    type timestamp;
    is required;
  }

  attribute created_by {
    type varchar(50);
    is required;
  }

  attribute updated_at {
    type timestamp;
  }

  attribute updated_by {
    type varchar(50);
  }

  attribute esr_code {
    type char(6);
  }

  attribute name {
    type varchar(255);
  }
}
