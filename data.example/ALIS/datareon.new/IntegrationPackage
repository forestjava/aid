// Интеграционный пакет ETRAN - входящий JSON накладной
json Datareon.Package {
  
  // ========================================
  // waybill - Накладная
  // ========================================
  attribute waybill_status {
    type string;
    is required;
    map ALIS.Waybill.status;
    relates DatareonGU27.waybill_status;
  }

  attribute waybill_type {
    type string;
    map ALIS.Waybill.type;
  }

  attribute waybill_number {
    type string;
    is required;
    map ALIS.Waybill.number;
  }

  attribute waybill_identifier {
    type string;
    is required;
    map ALIS.Waybill.waybillIdentifier;
  }

  attribute shipment_type {
    type string;
    map ALIS.Waybill.shipmentType;
  }

  attribute shipment_speed {
    type string;
    map ALIS.Waybill.shipmentSpeed;
  }

  attribute form_type {
    type string;
    map ALIS.Waybill.formType;
  }

  attribute delivery_deadline {
    type date;
    map ALIS.Waybill.deliveryDeadline;
  }

  attribute waybill_created_at {
    type date;
    map ALIS.Waybill.waybillCreatedAt;
  }

  attribute submitted_at {
    type date;
    map ALIS.Waybill.submittedAt;
  }

  attribute approved_at {
    type date;
    map ALIS.Waybill.approvedAt;
  }

  attribute accepted_at {
    type date;
    map ALIS.Waybill.acceptedAt;
  }

  attribute cargo_accepted_at {
    type date;
    map ALIS.Waybill.cargoAcceptedAt;
  }

  attribute departure_at {
    type date;
    map ALIS.Waybill.departureAt;
  }

  attribute departure_country {
    type string;
    map ALIS.Waybill.departureCountry;
  }

  // Станция отправления - lookup по коду
  attribute departure_station {
    type string;
    is required;
    map ALIS.RailwayStation.code;
  }

  attribute departure_station_code {
    type string;
    is required;
    map ALIS.RailwayStation.esrCode;
  }

  attribute destination_country {
    type string;
    map ALIS.Waybill.destinationCountry;
  }

  // Станция назначения - lookup по коду
  attribute destination_station {
    type string;
    is required;
    map ALIS.RailwayStation.code;
  }

  attribute destination_station_code {
    type string;
    is required;
    map ALIS.RailwayStation.esrCode;
  }

  attribute shipper_name {
    type string;
    map ALIS.Waybill.shipperName;
  }

  attribute shipper_address {
    type string;
    map ALIS.Waybill.shipperAddress;
  }

  attribute shipper_tgnl {
    type string;
    map ALIS.Waybill.shipperTgnl;
  }

  attribute shipper_okpo {
    type string;
    map ALIS.Waybill.shipperOkpo;
  }

  attribute consignee_name {
    type string;
    map ALIS.Waybill.consigneeName;
  }

  attribute consignee_address {
    type string;
    map ALIS.Waybill.consigneeAddress;
  }

  attribute consignee_tgnl {
    type string;
    map ALIS.Waybill.consigneeTgnl;
  }

  attribute consignee_okpo {
    type string;
    map ALIS.Waybill.consigneeOkpo;
  }

  attribute payer {
    type string;
    map ALIS.Waybill.payer;
  }

  attribute payer_code {
    type string;
    map ALIS.Waybill.payerCode;
  }

  attribute payment_form {
    type string;
    map ALIS.Waybill.paymentForm;
  }

  attribute payment_place {
    type string;
    map ALIS.Waybill.paymentPlace;
  }

  attribute wagon_ownership_type {
    type string;
    map ALIS.Waybill.railwayCarriageOwnershipType;
  }

  attribute planned_wagons {
    type number;
    map ALIS.Waybill.plannedRailwayCarriages;
  }

  attribute responsible_person {
    type string;
    map ALIS.Waybill.responsiblePerson;
  }

  attribute departure_route {
    type string;
    map ALIS.Waybill.departureRoute;
  }

  attribute destination_route {
    type string;
    map ALIS.Waybill.destinationRoute;
  }

  // ========================================
  // waybill_product - Грузы накладной (массив)
  // ========================================
  attribute products {
    type Datareon.Package.WaybillProductItem[];
  }

  // ========================================
  // waybill_railway_carriage - Вагоны (массив)
  // ========================================
  attribute railway_carriages {
    type Datareon.Package.WaybillRailwayCarriageItem[];
  }

  // ========================================
  // waybill_special_marks - Спец. отметки (массив)
  // ========================================
  attribute special_marks {
    type Datareon.Package.WaybillSpecialMarkItem[];
  }

  // ========================================
  // waybill_tariff_marks - Тарифные отметки (массив)
  // ========================================
  attribute tariff_marks {
    type Datareon.Package.WaybillTariffMarkItem[];
  }
}
