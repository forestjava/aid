// Тип загрузки
entity ALIS.LoadingType {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/loadingtype/LoadingType.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.loading_type.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.loading_type.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.loading_type.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.loading_type.active;
  }

  // Код типа загрузки
  attribute codeLoadingType {
    type String(20);
    is private;
    is nullable;
    map alis.loading_type.code_loading_type;
  }
}
