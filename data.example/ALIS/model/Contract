// Договор
entity ALIS.Contract {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/contract/Contract.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.contract.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.contract.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.contract.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.contract.active;
  }

  // Идентификатор для синхронизации
  attribute syncId {
    type UUID;
    is private;
    map alis.contract.sync_id;
  }

  // Идентификатор ЭДО
  attribute edoId {
    type String(46);
    is private;
    is nullable;
    map alis.contract.edo_id;
  }

  // Клиент
  attribute client {
    type ALIS.Client;
    is private;
    map alis.contract.client_id;  // -> ALIS.Client.id
  }

  // Компания
  attribute company {
    type ALIS.Company;
    is private;
    map alis.contract.company_id;  // -> ALIS.Company.id
  }

  // Валюта
  attribute currency {
    type ALIS.Currency;
    is private;
    map alis.contract.currency_id;  // -> ALIS.Currency.id
  }

  // Дата договора
  attribute contractDate {
    type Instant;
    is private;
    is nullable;
    map alis.contract.contract_date;
  }

  // Тип договора
  attribute contractType {
    type ALIS.ContractType;
    is private;
    is nullable;
    map alis.contract.contract_type;
  }

  // Действует с
  attribute validFrom {
    type Instant;
    is private;
    is nullable;
    map alis.contract.valid_from;
  }

  // Действует по
  attribute validTo {
    type Instant;
    is private;
    is nullable;
    map alis.contract.valid_to;
  }
}
