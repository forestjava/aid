// Накладная ЭТРАН
entity ALIS.EtranInvoice {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/etran/EtranInvoice.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.etran_invoice.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.etran_invoice.code;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.etran_invoice.active;
  }

  // Клиент - владелец товара
  attribute client {
    type ALIS.Client;
    is private;
    is nullable;
    map alis.etran_invoice.client_id;  // -> ALIS.Client.id
  }

  // Грузоотправитель
  attribute shipper {
    type ALIS.ClientRelatedEntity;
    is private;
    is nullable;
    map alis.etran_invoice.shipper_id;  // -> ALIS.ClientRelatedEntity.id
  }

  // Станция отправления
  attribute departureStation {
    type ALIS.RailwayStation;
    is private;
    is nullable;
    map alis.etran_invoice.departure_station_id;  // -> ALIS.RailwayStation.id
  }

  // Станция назначения
  attribute destinationStation {
    type ALIS.RailwayStation;
    is private;
    is nullable;
    map alis.etran_invoice.destination_station_id;  // -> ALIS.RailwayStation.id
  }

  // Вид отправки
  attribute transportationType {
    type ALIS.TransportationType;
    is private;
    is nullable;
    map alis.etran_invoice.transportation_type;
  }

  // Грузополучатель-компания
  attribute consigneeCompany {
    type ALIS.Company;
    is private;
    is nullable;
    map alis.etran_invoice.consignee_company_id;  // -> ALIS.Company.id
  }

  // Грузополучатель-клиент
  attribute consigneeClient {
    type ALIS.Client;
    is private;
    is nullable;
    map alis.etran_invoice.consignee_client_id;  // -> ALIS.Client.id
  }

  // Для заявки на поставку
  attribute isForReceivingOrder {
    type Boolean;
    is private;
    is nullable;
    map alis.etran_invoice.is_for_receiving_order;
  }

  // Создана в ЭТРАН
  attribute createdInEtran {
    type Boolean;
    is private;
    is nullable;
    map alis.etran_invoice.created_in_etran;
  }
}
