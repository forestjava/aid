// Периодичность услуг
entity ALIS.FrequencyOfServices {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/frequencyofservices/FrequencyOfServices.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.frequency_of_services.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.frequency_of_services.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.frequency_of_services.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.frequency_of_services.active;
  }

  // Код периодичности
  attribute codeFrequencyOfServices {
    type String(20);
    is private;
    is nullable;
    map alis.frequency_of_services.code_frequency_of_services;
  }
}
