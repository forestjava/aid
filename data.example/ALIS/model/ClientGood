// Номенклатура
entity ALIS.ClientGood {

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.client_good.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.client_good.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.client_good.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.client_good.active;
  }

  // Клиент
  attribute client {
    type ALIS.Client;
    is private;
    map alis.client_good.client_id;  // -> ALIS.Client.id
  }

  // Идентификатор для синхронизации с внешними системами
  attribute syncId {
    type UUID;
    is private;
    map alis.client_good.sync_id;
  }

  // Уникальный идентификатор номенклатуры КИС
  attribute codeKis {
    type String(8);
    is private;
    map alis.client_good.code_kis;
  }

  // Артикул
  attribute item {
    type String(100);
    is private;
    is nullable;
    map alis.client_good.item;
  }

  // Единица измерения
  attribute unitOfMeasure {
    type ALIS.UnitOfMeasure;
    is private;
    map alis.client_good.unit_of_measure_id;  // -> ALIS.UnitOfMeasure.id
  }

  // Вид номенклатуры
  attribute goodType {
    type ALIS.GoodType;
    is private;
    map alis.client_good.good_type_id;  // -> ALIS.GoodType.id
  }

  // Вид номенклатуры клиента
  attribute clientGoodType {
    type ALIS.ClientGoodType;
    is private;
    is nullable;
    map alis.client_good.client_good_type_id;  // -> ALIS.ClientGoodType.id
  }

  // Глобальный номер товарной позиции (GTIN)
  attribute gtin {
    type String(50);
    is private;
    is nullable;
    map alis.client_good.gtin;
  }

  // Вид партионного учета
  attribute batchAccountingType {
    type BatchAccountingType;
    is private;
    map alis.client_good.batch_accounting_type;
  }

  // Вид серийного учета
  attribute serialAccountingType {
    type SerialAccountingType;
    is private;
    map alis.client_good.serial_accounting_type;
  }

  // Срок хранения (дн.)
  attribute shelfLife {
    type BigDecimal;
    is private;
    is nullable;
    map alis.client_good.shelf_life;
  }

  // Класс опасности
  attribute dangerClass {
    type ALIS.DangerClass;
    is private;
    map alis.client_good.danger_class_id;  // -> ALIS.DangerClass.id
  }

  // Температурный режим
  attribute tempRegime {
    type ALIS.TempRegime;
    is private;
    is nullable;
    map alis.client_good.temp_regime_id;  // -> ALIS.TempRegime.id
  }

  // Цена
  attribute price {
    type BigDecimal;
    is private;
    map alis.client_good.price;
  }

  // Описание
  attribute description {
    type String(1000);
    is private;
    is nullable;
    map alis.client_good.description;
  }

  // Используется в заявках
  attribute usedInOrders {
    type Boolean;
    is private;
    map alis.client_good.used_in_orders;
  }

  // Группа номенклатуры
  attribute goodGroup {
    type ALIS.GoodGroup;
    is private;
    is nullable;
    map alis.client_good.good_group_id;  // -> ALIS.GoodGroup.id
  }
}
