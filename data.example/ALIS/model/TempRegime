// Температурный режим
entity ALIS.TempRegime {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/tempregime/TempRegime.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.temp_regime.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.temp_regime.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.temp_regime.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.temp_regime.active;
  }

  // Код температурного режима
  attribute codeTempRegime {
    type String(20);
    is private;
    is nullable;
    map alis.temp_regime.code_temp_regime;
  }
}
