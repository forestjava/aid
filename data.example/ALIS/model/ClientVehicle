// Транспортное средство клиента
entity ALIS.ClientVehicle {

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.client_vehicle.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.client_vehicle.code;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.client_vehicle.active;
  }

  // Идентификатор для синхронизации
  attribute syncId {
    type UUID;
    is private;
    map alis.client_vehicle.sync_id;
  }

  // Клиент
  attribute client {
    type ALIS.Client;
    is private;
    map alis.client_vehicle.client_id;  // -> ALIS.Client.id
  }

  // Марка ТС
  attribute vehicleBrand {
    type ALIS.VehicleBrand;
    is private;
    is nullable;
    map alis.client_vehicle.vehicle_brand_id;  // -> ALIS.VehicleBrand.id
  }

  // Тип ТС
  attribute vehicleType {
    type ALIS.VehicleType;
    is private;
    is nullable;
    map alis.client_vehicle.vehicle_type_id;  // -> ALIS.VehicleType.id
  }

  // Тип загрузки
  attribute loadingType {
    type ALIS.LoadingType;
    is private;
    is nullable;
    map alis.client_vehicle.loading_type_id;  // -> ALIS.LoadingType.id
  }

  // Рефрижератор
  attribute refrigerator {
    type Boolean;
    is private;
    is nullable;
    map alis.client_vehicle.refrigerator;
  }

  // С прицепом
  attribute withTrailer {
    type Boolean;
    is private;
    is nullable;
    map alis.client_vehicle.with_trailer;
  }

  // Номер прицепа
  attribute trailerNumber {
    type String(50);
    is private;
    is nullable;
    map alis.client_vehicle.trailer_number;
  }

  // Номер страховки
  attribute insuranceNumber {
    type String(50);
    is private;
    is nullable;
    map alis.client_vehicle.insurance_number;
  }

  // Тип владения транспортом
  attribute typeOwnershipTransport {
    type OwnershipType;
    is private;
    is nullable;
    map alis.client_vehicle.type_ownership_transport;
  }
}
