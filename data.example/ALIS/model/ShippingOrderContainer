// КТК заявки на вывоз
entity ALIS.ShippingOrderContainer {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/shippingordercontainer/ShippingOrderContainer.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.shipping_order_container.id;
  }

  attribute deleted {
    type Boolean;
    is private;
    default false;
    map alis.shipping_order_container.deleted;
  }

  attribute shippingOrder {
    type ALIS.ShippingOrder;
    is private;
    map alis.shipping_order_container.shipping_order_id;  // -> ALIS.ShippingOrder.id
  }

  attribute container {
    type ALIS.Container;
    is private;
    is nullable;
    map alis.shipping_order_container.container_id;  // -> ALIS.Container.id
  }

  attribute shippingOrderRailwayCarriage {
    type ALIS.ShippingOrderRailwayCarriage;
    is private;
    is nullable;
    map alis.shipping_order_container.shipping_order_railway_carriage_id;  // -> ALIS.ShippingOrderRailwayCarriage.id
  }

  attribute sealType {
    type ALIS.SealType;
    is private;
    is nullable;
    map alis.shipping_order_container.seal_type_id;  // -> ALIS.SealType.id
  }

  attribute dangerClass {
    type ALIS.DangerClass;
    is private;
    is nullable;
    map alis.shipping_order_container.danger_class_id;  // -> ALIS.DangerClass.id
  }

  attribute empty {
    type Boolean;
    is private;
    map alis.shipping_order_container.empty;
  }

  attribute weight {
    type BigDecimal;
    is private;
    is nullable;
    map alis.shipping_order_container.weight;
  }

  attribute customsClearance {
    type Boolean;
    is private;
    map alis.shipping_order_container.customs_clearance;
  }

  attribute actualQuantity {
    type BigDecimal;
    is private;
    is nullable;
    map alis.shipping_order_container.actual_quantity;
  }

  attribute status {
    type ALIS.TaskStatus;
    is private;
    is nullable;
    map alis.shipping_order_container.status;
  }

  attribute random {
    type Boolean;
    is private;
    map alis.shipping_order_container.random;
  }

  attribute dataTimeKrugloyePole {
    type Instant;
    is private;
    is nullable;
    map alis.shipping_order_container.data_time_krugloye_pole;
  }

  attribute customerService {
    type ALIS.ClientRelatedEntity;
    is private;
    is nullable;
    map alis.shipping_order_container.customer_services_id;  // -> ALIS.ClientRelatedEntity.id
  }

  attribute ownerRailwayCarriage {
    type ALIS.ClientRelatedEntity;
    is private;
    is nullable;
    map alis.shipping_order_container.owner_railway_carriage_id;  // -> ALIS.ClientRelatedEntity.id
  }

  attribute ownerContainer {
    type ALIS.ClientRelatedEntity;
    is private;
    is nullable;
    map alis.shipping_order_container.owner_container_id;  // -> ALIS.ClientRelatedEntity.id
  }

  attribute ktkNumberUnknown {
    type Boolean;
    is private;
    is nullable;
    map alis.shipping_order_container.ktk_number_unknown;
  }
}
