// Тип транспортного средства
entity ALIS.VehicleType {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/vehicletype/VehicleType.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.vehicle_type.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.vehicle_type.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.vehicle_type.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.vehicle_type.active;
  }

  // Код типа ТС
  attribute codeVehicleType {
    type String(20);
    is private;
    is nullable;
    map alis.vehicle_type.code_vehicle_type;
  }
}
