// Стандартный размер
entity ALIS.StandardSize {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/standardsize/StandardSize.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.standard_size.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.standard_size.code;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.standard_size.active;
  }
}
