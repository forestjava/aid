// Класс опасности
entity ALIS.DangerClass {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/dangerclass/DangerClass.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.danger_class.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.danger_class.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.danger_class.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.danger_class.active;
  }

  // Код класса опасности
  attribute codeDangerClass {
    type String(10);
    is private;
    is nullable;
    map alis.danger_class.code_danger_class;
  }

  // Наименование группы
  attribute groupName {
    type String(50);
    is private;
    is nullable;
    map alis.danger_class.group_name;
  }
}
