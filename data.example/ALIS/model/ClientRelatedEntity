// Контрагент клиента
entity ALIS.ClientRelatedEntity {

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.client_related_entity.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.client_related_entity.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.client_related_entity.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.client_related_entity.active;
  }

  // Идентификатор для синхронизации с внешними системами
  attribute syncId {
    type UUID;
    is private;
    map alis.client_related_entity.sync_id;
  }

  // ИНН
  attribute inn {
    type String(12);
    is private;
    is nullable;
    map alis.client_related_entity.inn;
  }

  // КПП
  attribute kpp {
    type String(9);
    is private;
    is nullable;
    map alis.client_related_entity.kpp;
  }

  // Клиент
  attribute client {
    type ALIS.Client;
    is private;
    map alis.client_related_entity.client_id;  // -> ALIS.Client.id
  }

  // Является ли грузоотправителем
  attribute isShipper {
    type Boolean;
    is private;
    map alis.client_related_entity.is_shipper;
  }

  // Является ли грузополучателем
  attribute isConsignee {
    type Boolean;
    is private;
    map alis.client_related_entity.is_consignee;
  }

  // Является ли перевозчиком
  attribute isCarrier {
    type Boolean;
    is private;
    map alis.client_related_entity.is_carrier;
  }

  // Юридический адрес
  attribute addressLegal {
    type String(1000);
    is private;
    is nullable;
    map alis.client_related_entity.address_legal;
  }

  // Фактический адрес
  attribute addressFact {
    type String(1000);
    is private;
    is nullable;
    map alis.client_related_entity.address_fact;
  }
}
