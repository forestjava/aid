// Единица измерения
entity ALIS.UnitOfMeasure {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/unitofmeasure/UnitOfMeasure.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.unit_of_measure.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.unit_of_measure.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.unit_of_measure.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.unit_of_measure.active;
  }

  // Код ОКЕИ
  attribute codeOkei {
    type String(10);
    is private;
    is nullable;
    map alis.unit_of_measure.code_okei;
  }
}
