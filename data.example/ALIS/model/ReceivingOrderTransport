// Транспорт заявки на поставку
entity ALIS.ReceivingOrderTransport {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/receivingordertransport/ReceivingOrderTransport.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.receiving_order_transport.id;
  }

  attribute shipper {
    type ALIS.ClientRelatedEntity;
    is private;
    is nullable;
    map alis.receiving_order_transport.shipper_id;  // -> ALIS.ClientRelatedEntity.id
  }

  attribute carrier {
    type ALIS.ClientRelatedEntity;
    is private;
    is nullable;
    map alis.receiving_order_transport.carrier_id;  // -> ALIS.ClientRelatedEntity.id
  }

  attribute clientVehicle {
    type ALIS.ClientVehicle;
    is private;
    is nullable;
    map alis.receiving_order_transport.client_vehicle_id;  // -> ALIS.ClientVehicle.id
  }

  attribute clientDriver {
    type ALIS.ClientDriver;
    is private;
    is nullable;
    map alis.receiving_order_transport.client_driver_id;  // -> ALIS.ClientDriver.id
  }

  attribute waybill {
    type String(100);
    is private;
    is nullable;
    map alis.receiving_order_transport.waybill;
  }
}
