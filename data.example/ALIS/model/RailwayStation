// Железнодорожная станция
entity ALIS.RailwayStation {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/railway/RailwayStation.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.railway_station.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.railway_station.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.railway_station.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.railway_station.active;
  }

  // Код ЕСР
  attribute esrCode {
    type String(20);
    is private;
    is nullable;
    map alis.railway_station.esr_code;
  }
}
