// Остаток контейнера
entity ALIS.ContainerRemain {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/containerremain/ContainerRemain.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.container_remain.id;
  }

  // Клиент
  attribute client {
    type ALIS.Client;
    is private;
    map alis.container_remain.client_id;  // -> ALIS.Client.id
  }

  // Контейнер (код)
  attribute container {
    type String(100);
    is private;
    map alis.container_remain.container;
  }

  // Статус зоны
  attribute containerRemainStatus {
    type ALIS.ContainerRemainStatus;
    is private;
    map alis.container_remain.zone_id;  // -> ALIS.ContainerRemainStatus.id
  }

  // Код ЕТСНГ
  attribute etsngCode {
    type String(50);
    is private;
    is nullable;
    map alis.container_remain.etsng_code;
  }

  // Фактическое количество
  attribute actualQuantity {
    type BigDecimal;
    is private;
    is nullable;
    map alis.container_remain.actual_quantity;
  }

  // Код события
  attribute eventCode {
    type String(50);
    is private;
    is nullable;
    map alis.container_remain.event_code;
  }

  // Признак активности
  attribute isActive {
    type Boolean;
    is private;
    is nullable;
    map alis.container_remain.active;
  }

  // Время
  attribute time {
    type Instant;
    is private;
    is nullable;
    map alis.container_remain.time;
  }
}
