// Крупнотоннажный контейнер (КТК)
entity ALIS.Container {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/container/Container.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.container.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.container.code;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.container.active;
  }

  // Тип КТК
  attribute containerType {
    type ALIS.ContainerType;
    is private;
    map alis.container.container_type;
  }

  // Масса тары (тн.)
  attribute weight {
    type BigDecimal;
    is private;
    map alis.container.weight;
  }

  // Рефрижератор
  attribute refrigerator {
    type Boolean;
    is private;
    map alis.container.refrigerator;
  }

  // Грузоподъемность (тн.)
  attribute liftingCapacity {
    type BigDecimal;
    is private;
    map alis.container.lifting_capacity;
  }

  // Размер КТК
  attribute standardSize {
    type ALIS.StandardSize;
    is private;
    is nullable;
    map alis.container.standard_size_id;  // -> ALIS.StandardSize.id
  }
}
