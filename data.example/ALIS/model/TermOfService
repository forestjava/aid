// Условие оказания услуги
entity ALIS.TermOfService {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/termofservice/TermOfService.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.term_of_service.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.term_of_service.code;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.term_of_service.active;
  }

  // Идентификатор для синхронизации
  attribute syncId {
    type UUID;
    is private;
    map alis.term_of_service.sync_id;
  }

  // Договор
  attribute contract {
    type ALIS.Contract;
    is private;
    map alis.term_of_service.contract_id;  // -> ALIS.Contract.id
  }

  // Площадка
  attribute terminalArea {
    type TerminalArea;
    is private;
    is nullable;
    map alis.term_of_service.terminal_area;
  }

  // Действует с
  attribute validFrom {
    type Instant;
    is private;
    is nullable;
    map alis.term_of_service.valid_from;
  }

  // Действует по
  attribute validTo {
    type Instant;
    is private;
    is nullable;
    map alis.term_of_service.valid_to;
  }

  // Признак бессрочности
  attribute indefinitely {
    type Boolean;
    is private;
    is nullable;
    map alis.term_of_service.indefinitely;
  }
}
