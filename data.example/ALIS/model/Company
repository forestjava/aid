// Компания
entity ALIS.Company {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/company/Company.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.company.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.company.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.company.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.company.active;
  }

  // Идентификатор для синхронизации
  attribute syncId {
    type UUID;
    is private;
    map alis.company.sync_id;
  }

  // ИНН
  attribute inn {
    type String(12);
    is private;
    is nullable;
    map alis.company.inn;
  }

  // КПП
  attribute kpp {
    type String(9);
    is private;
    is nullable;
    map alis.company.kpp;
  }

  // ОКПО
  attribute okpo {
    type String(10);
    is private;
    is nullable;
    map alis.company.okpo;
  }

  // ОГРН
  attribute ogrn {
    type String(13);
    is private;
    is nullable;
    map alis.company.ogrn;
  }

  // Идентификатор ЭДО
  attribute edoId {
    type String(46);
    is private;
    is nullable;
    map alis.company.edo_id;
  }

  // Юридический адрес
  attribute addressLegal {
    type String(1000);
    is private;
    is nullable;
    map alis.company.address_legal;
  }

  // Фактический адрес
  attribute addressFact {
    type String(1000);
    is private;
    is nullable;
    map alis.company.address_fact;
  }

  // ФИО подписанта
  attribute signatoryName {
    type String(50);
    is private;
    is nullable;
    map alis.company.signatory_name;
  }

  // Должность подписанта
  attribute signatoryPosition {
    type String(50);
    is private;
    is nullable;
    map alis.company.signatory_position;
  }
}
