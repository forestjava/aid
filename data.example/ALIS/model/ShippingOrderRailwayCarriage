// Вагон заявки на вывоз
entity ALIS.ShippingOrderRailwayCarriage {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/shippingorderrailwaycarriage/ShippingOrderRailwayCarriage.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.shipping_order_railway_carriage.id;
  }

  attribute deleted {
    type Boolean;
    is private;
    is nullable;
    map alis.shipping_order_railway_carriage.deleted;
  }

  attribute etranInvoice {
    type ALIS.EtranInvoice;
    is private;
    is nullable;
    map alis.shipping_order_railway_carriage.etran_invoice_id;  // -> ALIS.EtranInvoice.id
  }

  attribute railwayCarriage {
    type ALIS.RailwayCarriage;
    is private;
    map alis.shipping_order_railway_carriage.railway_carriage_id;  // -> ALIS.RailwayCarriage.id
  }

  attribute shippingOrder {
    type ALIS.ShippingOrder;
    is private;
    map alis.shipping_order_railway_carriage.shipping_order_id;  // -> ALIS.ShippingOrder.id
  }

  attribute status {
    type ALIS.TaskStatus;
    is private;
    is nullable;
    map alis.shipping_order_railway_carriage.status;
  }

  attribute dataTimeKrugloyePole {
    type Instant;
    is private;
    is nullable;
    map alis.shipping_order_railway_carriage.data_time_krugloye_pole;
  }

  attribute customerService {
    type ALIS.ClientRelatedEntity;
    is private;
    is nullable;
    map alis.shipping_order_railway_carriage.customer_services_id;  // -> ALIS.ClientRelatedEntity.id
  }

  attribute ownerRailwayCarriage {
    type ALIS.ClientRelatedEntity;
    is private;
    is nullable;
    map alis.shipping_order_railway_carriage.owner_railway_carriage_id;  // -> ALIS.ClientRelatedEntity.id
  }
}
