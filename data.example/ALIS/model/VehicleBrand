// Марка транспортного средства
entity ALIS.VehicleBrand {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/vehiclebrand/VehicleBrand.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.vehicle_brand.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.vehicle_brand.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.vehicle_brand.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.vehicle_brand.active;
  }

  // Код марки ТС
  attribute codeVehicleBrand {
    type String(20);
    is private;
    is nullable;
    map alis.vehicle_brand.code_vehicle_brand;
  }
}
