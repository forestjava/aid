// Код ЕТСНГ
entity ALIS.EtsngCode {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/etsng/EtsngCode.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.etsng_code.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.etsng_code.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.etsng_code.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.etsng_code.active;
  }
}
