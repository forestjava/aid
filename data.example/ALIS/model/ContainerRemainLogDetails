// Детали лога остатков контейнеров
entity ALIS.ContainerRemainLogDetails {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/containerremainlogdetails/ContainerRemainLogDetails.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.container_remain_log_details.id;
  }

  // Лог остатков
  attribute containerRemainLog {
    type ALIS.ContainerRemainLog;
    is private;
    map alis.container_remain_log_details.container_remain_log_id;  // -> ALIS.ContainerRemainLog.id
  }

  // Контейнер
  attribute container {
    type String(100);
    is private;
    map alis.container_remain_log_details.container;
  }

  // Комментарий
  attribute comment {
    type String;
    is private;
    is nullable;
    map alis.container_remain_log_details.comment;
  }
}
