// Накладная ЭТРАН заявки на вывоз
entity ALIS.ShippingOrderEtranInvoice {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/shippingorderetraninvoice/ShippingOrderEtranInvoice.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.shipping_order_etran_invoice.id;
  }

  attribute deleted {
    type Boolean;
    is private;
    is nullable;
    map alis.shipping_order_etran_invoice.deleted;
  }

  attribute etranInvoice {
    type ALIS.EtranInvoice;
    is private;
    map alis.shipping_order_etran_invoice.etran_invoice_id;  // -> ALIS.EtranInvoice.id
  }

  attribute shippingOrder {
    type ALIS.ShippingOrder;
    is private;
    map alis.shipping_order_etran_invoice.shipping_order_id;  // -> ALIS.ShippingOrder.id
  }
}
