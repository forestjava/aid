// Группа номенклатуры
entity ALIS.GoodGroup {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/goodgroup/GoodGroup.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.good_group.id;
  }

  // Наименование группы
  attribute code {
    type String(1000);
    is private;
    map alis.good_group.code;
  }

  // Родительская группа
  attribute parent {
    type ALIS.GoodGroup;
    is private;
    is nullable;
    map alis.good_group.parent_id;  // -> ALIS.GoodGroup.id
  }

  // Признак удаления
  attribute deleted {
    type Boolean;
    is private;
    default false;
    map alis.good_group.deleted;
  }

  // Идентификатор для синхронизации
  attribute syncId {
    type UUID;
    is private;
    is nullable;
    map alis.good_group.sync_id;
  }
}
