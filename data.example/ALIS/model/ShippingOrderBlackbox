// Блэкбокс заявки на вывоз
entity ALIS.ShippingOrderBlackbox {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/shippingorderblackbox/ShippingOrderBlackbox.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.shipping_order_blackbox.id;
  }

  attribute shippingOrder {
    type ALIS.ShippingOrder;
    is private;
    map alis.shipping_order_blackbox.shipping_order_id;  // -> ALIS.ShippingOrder.id
  }

  attribute cargo {
    type ALIS.Cargo;
    is private;
    map alis.shipping_order_blackbox.cargo_id;  // -> ALIS.Cargo.id
  }

  attribute deleted {
    type Boolean;
    is private;
    default false;
    map alis.shipping_order_blackbox.deleted;
  }
}
