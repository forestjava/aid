// Валюта
entity ALIS.Currency {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/currency/Currency.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.currency.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.currency.code;
  }

  attribute name {
    type String(255);
    is private;
    is nullable;
    map alis.currency.name;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.currency.active;
  }

  // Числовой код ОКВ
  attribute codeOkvNum {
    type String(10);
    is private;
    is nullable;
    map alis.currency.code_okv_num;
  }
}
