// Штрихкод упаковки
entity ALIS.GoodPackageBarcode {
  source "db-layer/src/main/java/ru/korusconsulting/alis/model/goodpackagebarcode/GoodPackageBarcode.java";

  attribute id {
    key primary;
    type UUID;
    is private;
    map alis.good_package_barcode.id;
  }

  attribute code {
    type String(100);
    is private;
    map alis.good_package_barcode.code;
  }

  attribute active {
    type Boolean;
    is protected;
    default true;
    map alis.good_package_barcode.active;
  }

  // Идентификатор для синхронизации
  attribute syncId {
    type UUID;
    is private;
    map alis.good_package_barcode.sync_id;
  }

  // Упаковка
  attribute goodPackage {
    type ALIS.GoodPackage;
    is private;
    map alis.good_package_barcode.good_package_id;  // -> ALIS.GoodPackage.id
  }

  // Номенклатура
  attribute clientGood {
    type ALIS.ClientGood;
    is private;
    is nullable;
    map alis.good_package_barcode.client_good_id;  // -> ALIS.ClientGood.id
  }
}
