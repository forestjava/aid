     is nullable;
   }

   // Кем создано
   attribute created_by {
     type varchar(50);
     is required;
   }

   // Кем изменено
   attribute updated_by {
     type varchar(50);
     is nullable;
   }

   // Идентификатор записи
   attribute id {
     type UUID;
     is required;
     key primary;
   }
}
