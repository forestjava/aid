
// ===== BEGIN: ALIS/model/receiving_order =====
entity ALIS.receiving_order {
   type Table;
   label "Заявки на приём";
   
   // Номер заявки
   attribute number {
     type numeric(9,0);
     is required;
   }

   // Статус заявки
   attribute order_status {
     type varchar(100);
     is required;
   }

   // Площадка
   attribute terminal_area {
     type varchar(100);
     is required;
   }

   // Тип транспорта
   attribute transport_type {
     type varchar(100);
     is required;
   }

   // Плановая дата приёма
   attribute plan_receiving_date_time {
     type timestamp;
     is nullable;
   }

   // Фактическая дата приёма
   attribute actual_receiving_date_time {
     type timestamp;
     is nullable;
   }

   // Тип доставки
   attribute delivery_type {
     type varchar(64);
     is nullable;
   }

   // Контактное лицо
   attribute contact_name {
     type varchar(100);
     is nullable;
   }

   // Телефон
   attribute contact_phone {
     type varchar(50);
     is nullable;
   }

   // Email
   attribute contact_email {
     type varchar(255);
     is nullable;
   }

   // Комментарий
   attribute comment {
     type varchar(512);
     is nullable;
   }

   // Кол-во SKU
   attribute total_sku_quantity {
     type numeric(16,3);
     is required;
   }

   // Общий вес
   attribute total_weight {
     type numeric(15,3);
     is nullable;
   }

   // Кол-во грузовых мест
   attribute total_cargo_quantity {
     type numeric(16,3);
     is required;
   }

   // Кол-во паллет
   attribute total_pallet_quantity {
     type numeric(16,3);
     is required;
   }

   // Кол-во грузомест без паллет
   attribute total_not_pallet_quantity {
     type numeric(16,3);
     is required;
   }

   // Стоимость товаров
   attribute total_goods_price {
     type numeric(15,2);
     is required;
   }

   // Кол-во доп. услуг
   attribute total_requested_service_quantity {
     type numeric(16,3);
     is required;
   }

   // Стоимость доп. услуг
   attribute total_requested_service_price {
     type numeric(15,2);
     is required;
   }

   // Срок хранения
   attribute storage_period {
     type numeric(4);
     is nullable;
   }

   // Кол-во контейнеров
   attribute total_container_quantity {
     type numeric(16,3);
     is required;
   }

   // Кол-во ж/д вагонов
   attribute total_railway_carriage_quantity {
     type numeric(16,3);
     is required;
   }

   // Требуется транспорт
   attribute need_transport {
     type boolean;
     is required;
   }

   // Накладная
   attribute waybill {
     type varchar(200);
     is nullable;
   }

   // Документы подтверждены
   attribute document_confirmed {
     type boolean;
     is nullable;
   }

   // Номер КТК неизвестен
   attribute ktk_number_unknown {
     type boolean;
     is nullable;
   }

   /*===============================================
   
           НАВИГАЦИОННЫЕ АТРИБУТЫ
           
   ===============================================*/

   // Клиент
   attribute client {
     type client;
     is required;
     key foreign {
       attribute client.id;
     }
   }

   // Договор
   attribute contract {
     type contract;
     is required;
     key foreign {
       attribute contract.id;
     }
   }

   // Валюта
   attribute currency {
     type currency;
     is nullable;
     key foreign {
       attribute currency.id;
     }
   }

   // Маршрут
   attribute route {
     type route;
     is nullable;
     key foreign {
       attribute route.id;
     }
   }
  
  method receiving_orders_containres {
    type receiving_order_container[];
  }
  
  method receiving_orders_containre_items {
    type receiving_order_container_item[];
  }

   method receiving_order_blackboxes {
      type receiving_order_blackbox[];
   }

   method receiving_order_etran_invoices {
      type receiving_order_etran_invoice[];
   }

   method receiving_order_cargoes {
      type receiving_order_cargo[];
   }

   method receiving_order_goods {
      type receiving_order_good[];
   }
   
   method receiving_order_railway_carriages {
      type receiving_order_railway_carriage[];
   }
   
   method receiving_order_requested_services {
      type receiving_order_requested_service[];
   }
   
   method receiving_order_transports {
      type receiving_order_transport[];
   }

   /*===============================================
   
             ТЕХНИЧЕСКИЕ АТРИБУТЫ
             
   ===============================================*/

   // Время создания
   attribute created_at {
     type timestamp;
     is required;
   }

   // Время изменения
   attribute updated_at {
     type timestamp;
     is nullable;
   }

   // Кем создано
   attribute created_by {
     type varchar(50);
     is required;
   }

   // Кем изменено
   attribute updated_by {
     type varchar(50);
     is nullable;
   }

   // Идентификатор заявки
   attribute id {
     type UUID;
     is required;
     key primary;
   }
}
// ===== END: ALIS/model/receiving_order =====


