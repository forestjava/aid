
entity DatareonBatch{
type JSON;
rank 2;
label "Batch";

 attribute GUID {
 type UUID;
 is required; 
}

 attribute number {
 type varchar(150);
 is required; 
}

 attribute barcode {
 type varchar(150);
 is required;
 is virtual;
}

 attribute issueDate {
 type timestamp;
 is required; 
}

 attribute expirationDate {
 type timestamp;
 is required; 
}

 attribute active {
 type boolean;
 is required; 
}

 attribute syncId {
 type varchar(150);
 is required; 
}

 attribute type {
 type varchar(150);
 is required; 
}

 attribute item {
 type varchar(150);
 is required; 
}

 attribute client {
 type varchar(150);
 is required; 
}
}

