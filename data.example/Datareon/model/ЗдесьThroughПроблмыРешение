// добавляем сущность Род
сущность Род {
  
  реквизит Индентификатор {
    тип Строка;
    sync Справочник.усПартииНоменклатуры.ИдентификаторТретьего {
      через ВидИдентификатора "Третье"; 
      клон Третье;
    }
    обмен Справочник.усПартииНоменклатуры.ИдентификаторВторого {
      через ВидИдентификатора "Второе"; 
      клон Второе;
    }
    обмен Справочник.усПартииНоменклатуры.ИдентификаторОдного {
      через ВидИдентификатора "Одно"; 
      клон Одно;
    }

  }
  
  реквизит ВидИдентификатора {
    тип Строка;
    значение "Одно";
    значение "Второе";
    значение "Третье";
  }

  реквизит Ещё;
  реквизит Всякие;  
  реквизит Реквизиты;
  
}
