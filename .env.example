# TOiR Fullstack Exporter — Configuration
# These values MUST be set before running docker compose up

# LLM config
AI_API_KEY=sk-or-v1-your-key-here
AI_MODEL=moonshotai/kimi-k2.5
AI_MAX_TOKENS=16000
# AI_TEMPERATURE=0.7         # default 0.7
# AI_API_URL=https://openrouter.ai/api/v1/chat/completions  # default

# Gitea API Token (created for toir-bot user)
GITEA_TOKEN=your-gitea-token-here

# Portainer API Key (X-API-Key header)
PORTAINER_API_KEY=ptr_your-key-here

# Nginx Proxy Manager credentials
NPM_IDENTITY=your-npm-email@example.com
NPM_SECRET=your-npm-password-here
