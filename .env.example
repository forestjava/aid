# ─────────────────────────────────────────────────────────────
# Контур развёртывания (prod / dev)
# Задаются в Portainer → Stack → Environment variables
# ─────────────────────────────────────────────────────────────

# Суффикс к container_name для всех сервисов. Пусто для prod, "-dev" для dev.
ENV_SUFFIX=

# ─────────────────────────────────────────────────────────────
# URL runner'ов. По умолчанию собираются в compose как
# http://aid-runner-<name>${ENV_SUFFIX}:<port> — задавать вручную
# нужно только если runner живёт вне compose-стека (напр. contract-craft).
# ─────────────────────────────────────────────────────────────
EXPORTER_CONTRACT_URL=http://contract-craft-dev-service:8080
# EXPORTER_DEMO_URL=
# EXPORTER_CRUD_API_URL=
# EXPORTER_PRISMA_URL=
# EXPORTER_NESTJS_URL=
# EXPORTER_REACT_ADMIN_URL=

# Передаётся в сборку frontend.
VITE_COPYRIGHT=

# ─────────────────────────────────────────────────────────────
# LLM / OpenRouter — используется runner'ами.
# ─────────────────────────────────────────────────────────────
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=
AI_TEMPERATURE=

# ─────────────────────────────────────────────────────────────
# Gitea — целевой git-хостинг для сгенерированных репозиториев.
# ─────────────────────────────────────────────────────────────
GITEA_URL=
GITEA_TOKEN=
GITEA_ORG=
GITEA_USER=

# ─────────────────────────────────────────────────────────────
# Portainer — разворачивает сгенерированные стеки.
# ─────────────────────────────────────────────────────────────
PORTAINER_URL=
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=

# ─────────────────────────────────────────────────────────────
# Keycloak — SSO-провайдер для сгенерированных стеков.
# ─────────────────────────────────────────────────────────────
KEYCLOAK_ISSUER_URL=
KEYCLOAK_AUDIENCE=
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
