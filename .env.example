# ─────────────────────────────────────────────────────────────
# Контур развёртывания (prod / dev)
# Задаются в Portainer → Stack → Environment variables
# ─────────────────────────────────────────────────────────────

# Суффикс к container_name для всех сервисов. Пусто для prod, "-dev" для dev.
ENV_SUFFIX=

# ─────────────────────────────────────────────────────────────
# URL runner'ов внутри сети internal. В dev-контуре меняются на *-dev адреса.
# ─────────────────────────────────────────────────────────────
EXPORTER_DEMO_URL=http://aid-runner-demo:3003
EXPORTER_CRUD_API_URL=http://aid-runner-crud-api-exporter:3003
EXPORTER_CONTRACT_URL=http://contract-craft-dev-service:8080
EXPORTER_PRISMA_URL=http://aid-runner-prisma:3004
EXPORTER_NESTJS_URL=http://aid-runner-nestjs:3005
EXPORTER_REACT_ADMIN_URL=http://aid-runner-react-admin:3006

# Передаётся в сборку frontend.
VITE_COPYRIGHT=

# ─────────────────────────────────────────────────────────────
# LLM / OpenRouter — используется runner'ами.
# ─────────────────────────────────────────────────────────────
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=
AI_TEMPERATURE=

# ─────────────────────────────────────────────────────────────
# Gitea — целевой git-хостинг для сгенерированных репозиториев.
# ─────────────────────────────────────────────────────────────
GITEA_URL=
GITEA_TOKEN=
GITEA_ORG=
GITEA_USER=

# ─────────────────────────────────────────────────────────────
# Portainer — разворачивает сгенерированные стеки.
# ─────────────────────────────────────────────────────────────
PORTAINER_URL=
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=

# ─────────────────────────────────────────────────────────────
# Keycloak — SSO-провайдер для сгенерированных стеков.
# ─────────────────────────────────────────────────────────────
KEYCLOAK_ISSUER_URL=
KEYCLOAK_AUDIENCE=
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=
