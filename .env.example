# ─────────────────────────────────────────────────────────────
# Контур развёртывания (prod / dev)
# Задаются в Portainer → Stack → Environment variables
# ─────────────────────────────────────────────────────────────

# Суффикс к container_name для всех сервисов. Пусто для prod, "-dev" для dev.
ENV_SUFFIX=

# Host-путь с данными AID (монтируется в backend как /data).
DATA_HOST_PATH=/data/aid

# URL runner'ов внутри сети proxy. В dev-контуре меняются на *-dev адреса.
EXPORTER_DEMO_URL=http://aid-runner-demo:3003
EXPORTER_CRUD_API_URL=http://aid-runner-crud-api-exporter:3003
EXPORTER_CONTRACT_URL=http://contract-craft-dev-service:8080

# Передаётся в сборку frontend.
VITE_COPYRIGHT=

# LLM настройки для crud-api-exporter.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=
AI_TEMPERATURE=
