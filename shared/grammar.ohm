DSL {
  
  // Основное правило - список сущностей
  Program = Entity+
  
  // Сущность - это ключевое слово + наименование и + опционально блок содержимого
  
  // Используем case names для разделения веток с разной арностью
  //Entity = keyword name ";"         --simple
  //       | keyword name Block ";"?  --options

  // Описываем особенности для ключевых слов type, строковых и числовых значений
  Entity = annotationKeyword name? AnnotationBlock ";"?  --annotation
         | typeKeyword typeRef Block ";"?                --typeOptions
         | typeKeyword typeRef ";"                       --type
         | translate typeRef stringValue? ";"            --translate
         | refKeyword ref Block ";"?                     --refOptions
         | refKeyword ref ";"                            --ref
         | importKeyword ref ";"                         --importRef
         | importKeyword stringValue ";"                 --importString
         | stringKeyword stringValue ";"                 --string
         | numberKeyword numberValue ";"                 --number
         | valueKeyword anyValue ";"                     --value
         | throughKeyword ref anyValue ";"               --condition
         | keyword name ";"                              --simple
         | keyword name Block ";"?                       --options


  // Блок содержит набор элементов в фигурных скобках
  Block = "{" Item* "}"
  
  // Элемент может быть другой сущностью
  Item = Entity

  // Блок аннотации содержит произвольный текст между { и }
  AnnotationBlock = "{" annotationContent "}"
  
  // Содержимое - любые символы кроме закрывающей фигурной скобки
  annotationContent = (~"}" any)*
    
  // Ключевые слова
  annotationKeyword = "annotation" | "аннотация"
  
  typeKeyword = "type" | "тип"
  translate = "translate"
  
  refKeyword = "sync" | "обмен" | "map" | "relates" | "связь" | "относится"
  
  importKeyword = "import" | "из"
  
  stringKeyword = "label" | "заголовок" | "description" | "описание" | "source" | "источник" | "route"
  
  numberKeyword = "width" | "ширина" 
    | "height" | "высота" 
    | "separate" | "промежуток" 
    | "rank" | "позиция" 
    | "offset" | "сдвиг" 
    | "priority" | "приоритет" 
    | "code" | "код"
    | "limit" | "лимит"
  
  valueKeyword = "value" | "значение" 
    | "clone" | "клон" 
    | "default" 
    | "only" | "только"
    | "filter" | "фильтр"
    | "const"
  
  throughKeyword = "through" | "через" 
      | "using" | "используя" 
      | "for" | "для" 
      | "if" | "если" 
      | "when" | "когда"
  
  keyword = "entity" | "сущность"      
      | "class"      | "класс"
      | "enum"       | "перечисление"
      | "set"        | "набор"
      | "group"      | "группа"
      | "scheme"     | "схема"
      | "service"    | "сервис"
      | "system"     | "система"

      | "attribute"  | "реквизит"
      | "property"   | "свойство"
      | "method"     | "метод"

      | "is"         | "это"
      | "key"        | "ключ"

      | "table"      | "таблица"
      | "model"      | "модель"
      | "json"
      | "dto"
      | "store"
      | "ui"
      
      | "api"
      | "endpoint"
      | "request"
      | "response"
      | "view"
      | "interface"

      | "value"      | "значение"

  // Имя в общем случае может быть только идентификатором
  name = identifier

  // Универсальная ссылка на идентификатор (сущность, атрибут, путь)
  // Примеры: string, MyEntity.Field, ./local/MyType, ../shared/Type, Demo/Post.attribute
  // С опциональным суффиксом клона внутри: Entity(cloneName).attribute
  ref = relativePrefix? pathBody
  
  // Суффикс клона: (cloneName) — используется в identifierPart
  cloneSuffix = "(" name ")"

  // Ссылка на тип — это ref + опциональная размерность + опциональный признак коллекции
  // Примеры: string, Demo/Post[], decimal(10,2), varchar(200)
  typeRef = ref ("(" digit+ ("," digit+)* ")")? "[]"?

  // Префикс относительного пути: / root, ./ или один или несколько ../
  relativePrefix = "/" | "./" | ("../")+

  // Тело пути: идентификаторы, разделённые /
  pathBody = identifier ("/" identifier)*

  // Строковое значение - это строковый литерал
  stringValue = stringLiteral

  // Числовое значение - это целое или дробное число
  numberValue = "-"? digit+ ("." digit+)?

  // Универсальное значение - строка, число или ссылка
  anyValue = stringValue | numberValue | ref

  // Идентификатор может быть составным через точку (неограниченная вложенность)
  // Каждая часть может иметь опциональный суффикс клона: Entity(clone).attribute
  identifier = identifierPart ("." identifierPart)*
  
  // Часть идентификатора: имя + опциональный суффикс клона
  identifierPart = simpleIdentifier cloneSuffix?

  // Простой идентификатор начинается с буквы или "_" и содержит буквы/цифры
  simpleIdentifier = ("_" | letter) (letter | digit | "_")*

  // Строковый литерал в двойных кавычках
  stringLiteral = "\"" stringChar* "\""
  stringChar = ~("\"" | "\n" | "\r") any

  // Переопределяем правило space для поддержки комментариев
  space += comment

  // Комментарий может быть однострочным или многострочным
  comment = multiLineComment | singleLineComment

  // Однострочный комментарий: от // до конца строки
  singleLineComment = "//" (~"\n" any)*

  // Многострочный комментарий: от /* до */
  multiLineComment = "/*" (~"*/" any)* "*/"

}
